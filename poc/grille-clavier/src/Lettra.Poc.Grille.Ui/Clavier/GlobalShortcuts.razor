@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ShortcutRegistry Registry
@* Pousse un scope de raccourcis globaux (ex. Ctrl+Shift+D densité, F1 aide) et l'écoute sur le document. *@

@code {
    [Parameter, EditorRequired] public KeyboardScope Scope { get; set; } = default!;

    private IDisposable? _registration;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<GlobalShortcuts>? _self;

    protected override void OnInitialized() => _registration = Registry.PushScope(Scope);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Lettra.Poc.Grille.Ui/grid-keyboard.js");
        _self = DotNetObjectReference.Create(this);
        _handle = await _module.InvokeAsync<IJSObjectReference>("attachGlobal", _self, ShortcutRegistry.KeysOf(Scope));
    }

    [JSInvokable]
    public Task OnShortcut(string chord) => Registry.TryHandleAsync(KeyChord.Parse(chord), CommandContext.None);

    public async ValueTask DisposeAsync()
    {
        _registration?.Dispose();
        try
        {
            if (_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
