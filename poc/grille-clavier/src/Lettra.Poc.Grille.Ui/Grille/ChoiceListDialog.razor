@typeparam TItem
@* Liste de choix au clavier (F4 article, F3 recherche) : saisie filtrante, flèches, Entrée, Échap. *@
<div class="lg-dialog-backdrop" @onclick="CancelAsync">
    <div class="lg-dialog" role="dialog" aria-modal="true" aria-labelledby="lg-dialog-title" @onclick:stopPropagation>
        <h2 id="lg-dialog-title">@Title</h2>
        <input @ref="_input" value="@_filter" @oninput="OnInput" @onkeydown="OnKeyDown"
               role="combobox" aria-expanded="true" aria-controls="lg-options" autocomplete="off"
               aria-activedescendant="@(_matches.Count > 0 ? $"lg-opt-{_highlight}" : null)" />
        <ul id="lg-options" class="lg-options" role="listbox">
            @for (var i = 0; i < _matches.Count; i++)
            {
                var index = i;
                <li id="lg-opt-@i" role="option" aria-selected="@(i == _highlight ? "true" : "false")"
                    @onclick="() => SelectAsync(index)">@ItemText(_matches[i])</li>
            }
        </ul>
        <div class="lg-hint">↑ ↓ pour choisir · Entrée pour valider · Échap pour annuler · @_total résultat(s)</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string, bool> Matches { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> ItemText { get; set; } = default!;
    [Parameter] public string InitialFilter { get; set; } = "";
    [Parameter] public int MaxResults { get; set; } = 50;
    [Parameter] public EventCallback<TItem> OnSelected { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ElementReference _input;
    private string _filter = "";
    private List<TItem> _matches = new();
    private int _total;
    private int _highlight;

    protected override void OnInitialized()
    {
        _filter = InitialFilter;
        Apply();
        if (_matches.Count == 0 && _filter.Length > 0) { _filter = ""; Apply(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _input.FocusAsync();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        Apply();
    }

    private void Apply()
    {
        var all = Items.Where(i => Matches(i, _filter.Trim()));
        _total = all.Count();
        _matches = all.Take(MaxResults).ToList();
        _highlight = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": _highlight = Math.Min(_highlight + 1, Math.Max(0, _matches.Count - 1)); break;
            case "ArrowUp": _highlight = Math.Max(_highlight - 1, 0); break;
            case "PageDown": _highlight = Math.Min(_highlight + 10, Math.Max(0, _matches.Count - 1)); break;
            case "PageUp": _highlight = Math.Max(_highlight - 10, 0); break;
            case "Enter": await SelectAsync(_highlight); break;
            case "Escape": await CancelAsync(); break;
        }
    }

    private async Task SelectAsync(int index)
    {
        if (index >= 0 && index < _matches.Count) await OnSelected.InvokeAsync(_matches[index]);
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
