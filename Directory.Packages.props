<Project>

  <!-- Gestion centralisée des versions (Central Package Management). Aucun
       .csproj ne porte de version. Les versions Microsoft.* suivent le runtime
       .NET 10 de la CI. -->
  <!-- Les POC (poc/<nom>/) sont autonomes et gèrent leurs propres versions : ce fichier ne s'applique pas à eux. -->
  <PropertyGroup>
    <LettraIsPoc>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\','/').Contains('/poc/'))</LettraIsPoc>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LettraIsPoc)' != 'true'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <MicrosoftVersion>10.0.13</MicrosoftVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Persistance">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="$(MicrosoftVersion)" />
    <!-- SQLite3 Multiple Ciphers (MIT) remplace SQLCipher, dont le bundle n'est plus maintenu (POC base par dossier). -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Hôtes et UI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="$(MicrosoftVersion)" />
    <!-- Rendu PDF des documents (MIT), managé pur : WASM, MAUI hors ligne et serveur. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Phase 2 : hôtes, identité, services externes, observabilité">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="IA (annexe B)">
    <!-- SDK officiel C# d'Anthropic (MIT), utilisé seulement par Lettra.Ai.Claude. -->
    <PackageVersion Include="Anthropic" Version="12.56.0" />
    <!-- Clients Claude en région UE (Amazon Bedrock, Google Vertex AI), seulement par Lettra.Ai.Claude. -->
    <PackageVersion Include="Anthropic.Bedrock" Version="0.13.7" />
    <PackageVersion Include="Anthropic.Vertex" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Voix (vague 5)">
    <!-- Whisper.net (MIT) : whisper.cpp embarqué, transcription sur le poste sans réseau. Seulement par
         Lettra.Infrastructure.Speech.OnDevice ; le runtime porte les bibliothèques natives de chaque plateforme. -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Correctifs de sécurité transitifs (épinglés)">
    <!-- Tiré par Microsoft.Data.SqlClient en 9.0.11, vulnérable (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(LettraIsPoc)' != 'true'" Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- FluentAssertions 7.x : dernière ligne sous licence Apache 2.0 (la 8 est commerciale). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
  </ItemGroup>

</Project>
