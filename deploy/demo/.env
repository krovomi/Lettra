# Valeurs de DÉMONSTRATION uniquement, publiques et sans valeur : ne jamais les réutiliser hors de deploy/demo.
# Docker Compose lit ce fichier automatiquement (projet deploy/demo).

# Ports sur le poste (navigateur : http://localhost:8080/).
LETTRA_DEMO_PORT=8080
LETTRA_DEMO_KEYCLOAK_PORT=8081

# Utilisateur de démonstration « demo » (cabinet fictif) et compte d'administration de Keycloak (admin).
LETTRA_DEMO_PASSWORD=demo-lettra-demo
KEYCLOAK_ADMIN_PASSWORD=admin-demo

# Compte d'administration de Grafana (compose.observabilite.yaml, http://localhost:3000, utilisateur admin). La lecture
# des tableaux de bord se fait sans connexion.
GRAFANA_ADMIN_PASSWORD=admin-demo

# Secret du client lettra-bff partagé entre Keycloak et l'API, et clé de chiffrement du cabinet (32 octets en base64).
LETTRA_BFF_CLIENT_SECRET=demo-demo-demo-demo-demo-demo-demo-demo
LETTRA_DEMO_KEK=ZGVtby1sZXR0cmEta2VrLW5lLXBhcy11dGlsaXNlciE=

# Profil réseau local (compose.lan.yaml) : nom ou adresse IP du poste vu par le téléphone, par exemple 192.168.1.20.
LETTRA_DEMO_HOST=
