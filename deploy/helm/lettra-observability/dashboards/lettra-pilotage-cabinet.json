{
  "uid": "lettra-pilotage-cabinet",
  "title": "Lettra · Pilotage du cabinet",
  "description": "Indicateurs de gestion de tous les dossiers du cabinet, pour les experts-comptables et managers.",
  "tags": [
    "lettra",
    "pilotage"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pilotage"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Pilotage"
    },
    {
      "type": "dashboards",
      "tags": [
        "lettra"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "title": "Tous les tableaux Lettra"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métriques",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Pilotage du cabinet** · un dossier par ligne, recalculé toutes les 5 minutes (les compteurs « à faire » viennent du calcul de la nuit de la *Vue cabinet*).\nVert : rien à signaler · orange : à surveiller · rouge : à traiter. Aucun montant ni nom de client ici : des délais, des parts et des nombres. Cliquer sur un dossier ouvre son tableau détaillé."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dossiers suivis",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "—",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count(lettra_kpi_dossier_info) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
