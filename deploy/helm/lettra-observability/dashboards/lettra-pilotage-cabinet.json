          "expr": "count(max by (dossier_id) (lettra_kpi_cabinet_indicator_level) >= 3) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Dossiers dont au moins un compteur de la Vue cabinet est urgent (facture très en retard, TVA en retard, rejet de la plateforme…)."
    },
