{
  "uid": "lettra-activite",
  "title": "Lettra · Activité",
  "description": "Requêtes par route, latence p50/p95/p99, erreurs, cas d'usage, outbox, synchronisations, connexions et assistant ; liens vers les traces et les journaux.",
  "tags": [
    "lettra",
    "activite"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métriques",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Journaux",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lettra"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Tableaux Lettra"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Activité de l'API Lettra : requêtes, latence, erreurs, cas d'usage, outbox, synchronisations, connexions et assistant. Un point (exemplaire) sur une courbe de latence ouvre la trace de la requête dans Tempo ; une trace ouvre ses journaux dans Loki. **Aucune donnée de dossier** dans ces signaux : le collecteur les filtre comme dans une cellule (annexe G)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"lettra/lettra-api\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latence p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"lettra/lettra-api\"}[$__rate_interval])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Réponses 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 8,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"lettra/lettra-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"lettra/lettra-api\"}[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
