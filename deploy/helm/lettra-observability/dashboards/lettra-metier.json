{
  "uid": "lettra-metier",
  "title": "Lettra · Métier",
  "description": "Devis, factures, avoirs, transmissions à la plateforme agréée et exports FEC, en nombres seulement (annexe G).",
  "tags": [
    "lettra",
    "metier"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métriques",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "lettra"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Tableaux Lettra"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Activité métier du cabinet, **en nombres seulement** : aucun montant, client, dossier ni personne dans ces métriques (annexe G). Chaque cas d'usage réussi est compté à la sortie du pipeline ; « Factures validées » compte toute pièce validée (factures, acomptes et avoirs)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devis créés",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(lettra_document_count_total{lettra_document_type=\"quote\",lettra_document_action=\"created\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Devis acceptés",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
