{
  "uid": "lettra-pilotage-dossier",
  "title": "Lettra · Pilotage d'un dossier",
  "description": "Indicateurs de gestion d'un dossier : clients, encaissements, devis, activité mensuelle et points à traiter.",
  "tags": [
    "lettra",
    "pilotage"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pilotage"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Pilotage"
    },
    {
      "type": "dashboards",
      "tags": [
        "lettra"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "title": "Tous les tableaux Lettra"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métriques",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      },
      {
        "name": "dossier",
        "label": "Dossier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "query_result(lettra_kpi_dossier_info)",
          "refId": "dossier"
        },
        "definition": "query_result(lettra_kpi_dossier_info)",
        "regex": "/dossier=\"(?<text>(?:[^\"\\\\]|\\\\.)*)\",dossier_id=\"(?<value>[^\"]+)\"/",
        "refresh": 2,
        "sort": 5,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Pilotage du dossier** · choisir le dossier en haut. *Délai moyen de paiement* : en combien de jours les clients paient, en moyenne (au-delà de 60 jours, c'est hors délai légal). *Part en retard* : ce qui reste à encaisser et dont l'échéance est passée. *Transformation* : devis acceptés sur les devis tranchés (acceptés, refusés ou expirés) des 12 derniers mois. *Indice* : 100 = un mois moyen des 12 derniers mois."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Clients et encaissements",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Délai moyen de paiement",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "noValue": "—",
          "unit": "suffix: j",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "max(lettra_kpi_dso_days{dossier_id=\"$dossier\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "En combien de jours les clients paient, en moyenne, sur les ventes des 90 derniers jours (DSO)."
    },
