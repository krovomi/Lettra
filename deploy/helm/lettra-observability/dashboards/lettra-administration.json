{
  "uid": "lettra-administration",
  "title": "Lettra · Administration",
  "description": "Santé de Lettra pour les administrateurs : service, sécurité, alertes, postes, personnes, dossiers et calculs automatiques.",
  "tags": [
    "lettra",
    "pilotage"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pilotage"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Pilotage"
    },
    {
      "type": "dashboards",
      "tags": [
        "lettra"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "title": "Tous les tableaux Lettra"
    },
    {
      "type": "link",
      "title": "Activité technique détaillée",
      "url": "/d/lettra-activite",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Objectifs de service",
      "url": "/d/lettra-slo",
      "icon": "dashboard",
      "keepTime": true
