  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Métriques",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Administration** · la santé de Lettra pour les administrateurs : erreurs et lenteurs de l'API, connexions refusées, alertes ouvertes, envois en attente, postes qui ne se synchronisent plus, personnes et dossiers, place occupée par chaque dossier, et fraîcheur des calculs automatiques. Vert : tout va bien · orange : à surveiller · rouge : à traiter."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Service",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs de l'API (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "noValue": "—",
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"lettra/lettra-api\",http_response_status_code=~\"5..\"}[1h])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"lettra/lettra-api\"}[1h])), 1e-9)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Part des requêtes de l'API qui ont échoué côté serveur (5xx) sur la dernière heure. Objectif : moins de 0,1 %."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Temps de réponse (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "—",
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"lettra/lettra-api\"}[5m])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "95 % des requêtes répondent plus vite que ce temps. Objectif : moins de 300 ms."
    },
