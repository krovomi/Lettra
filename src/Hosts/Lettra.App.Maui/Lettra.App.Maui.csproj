<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Blazor Hybrid (.NET MAUI), mode 1 (poste isolé, gateway in-process, SQLite local) : Windows, macOS (Mac Catalyst),
       iOS et Android, une seule application. Chaque plateforme se construit là où sa chaîne d'outils existe : Android
       partout, iOS et Mac Catalyst sous macOS (Xcode), Windows sous Windows. Sous Windows, Android s'ajoute dès que la
       charge de travail est installée (Visual Studio avec MAUI), sauf pour une publication Windows (-r win-x64).
       Chaque plateforme a son job CI (build, premier lancement, artefact). -->
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) And Exists('$(NetCoreTargetingPackRoot)\Microsoft.Android.Sdk.Windows') And '$(RuntimeIdentifier)' == ''">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <RootNamespace>Lettra.App.Maui</RootNamespace>
    <ApplicationTitle>Lettra</ApplicationTitle>
    <ApplicationId>fr.lettra.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Le code généré par MAUI/WinUI ne respecte pas tous nos analyseurs : avertissements visibles, non bloquants ici. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1515;CA1848</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <OutputType>WinExe</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Sur l'appareil (AOT complet), EF Core a besoin de l'interpréteur pour ce que l'AOT ne précompile pas. -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Micro de la dictée (com.apple.security.device.audio-input). -->
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <!-- ASP.NET Core n'existe pas sur Android, iOS ni Mac Catalyst : sa référence de framework, héritée de la composition
       (endpoints de supervision, instrumentation OpenTelemetry), n'est pas reprise. Le poste n'exécute aucun de ces
       chemins serveur. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <!-- EF Core et la composition (configuration, injection) reposent sur la réflexion : pas de découpage sur mobile,
       comme sous Windows. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PublishTrimmed>false</PublishTrimmed>
    <!-- La précompilation AOT d'Android exige le découpage : compilation à la volée. -->
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <!-- Clé de signature de DÉMONSTRATION, versionnée et publique comme les secrets de deploy/demo/.env : chaque APK (CI ou
       poste) est signé avec la même clé, donc « adb install -r » d'une nouvelle version garde les données de l'application.
       Avec la clé de débogage par défaut, recréée sur chaque machine de CI, Android refuse la mise à jour
       (INSTALL_FAILED_UPDATE_INCOMPATIBLE) et il faut désinstaller, ce qui efface les données. Jamais pour un magasin. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(AndroidSigningKeyStore)' == ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)Platforms/Android/lettra-demo.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>lettra-demo</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>lettra-demo-android</AndroidSigningStorePass>
    <AndroidSigningKeyPass>lettra-demo-android</AndroidSigningKeyPass>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <!-- Version de mesure de la grille (critère J1) : dotnet publish -p:LettraGridBenchmark=true. Elle s'ouvre sur
       /mesure-grille et lance la mesure ; autonome (runtime .NET et Windows App SDK embarqués), elle se lance sans
       installation sur un poste du cabinet. -->
  <PropertyGroup Condition="'$(LettraGridBenchmark)' == 'true'">
    <DefineConstants>$(DefineConstants);LETTRA_GRID_BENCHMARK</DefineConstants>
    <ApplicationTitle>Lettra · mesure de la grille</ApplicationTitle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LettraGridBenchmark)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Version de démonstration (par défaut, donc les artefacts CI lettra-windows, lettra-android, lettra-ios-simulator
       et lettra-macos) : le poste isolé charge le jeu « Cabinet Démo » (Lettra.DemoData) en arrière-plan après la
       création du compte local. -p:LettraDemo=false le retire ; la version de mesure de la grille ne l'a jamais. -->
  <PropertyGroup>
    <LettraDemo Condition="'$(LettraDemo)' == '' And '$(LettraGridBenchmark)' != 'true'">true</LettraDemo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LettraDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);LETTRA_DEMO</DefineConstants>
  </PropertyGroup>

  <!-- Dictée sur le poste (Whisper.net) : ouverte par défaut, dans la version de démonstration comme sans elle.
       -p:LettraDictee=false la ferme par défaut sur ce build ; sur un poste, Lettra:Speech:Engine dans lettra.json
       (None ou OnDevice) l'emporte (DeviceSpeech.cs). -->
  <PropertyGroup Condition="'$(LettraDictee)' == 'false'">
    <DefineConstants>$(DefineConstants);LETTRA_SANS_DICTEE</DefineConstants>
  </PropertyGroup>

  <!-- Android : la version de démonstration approuve aussi les autorités de certification installées par l'utilisateur
       (certificat racine du profil HTTPS en réseau local, deploy/demo/compose.lan.yaml). Sa configuration réseau
       remplace celle de Platforms/Android/Resources, qui n'approuve que les autorités du système (-p:LettraDemo=false).
       Même nom de ressource (@xml/network_security_config dans AndroidManifest.xml) : un seul fichier dans l'APK. -->
  <ItemGroup Condition="'$(LettraDemo)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\Demo\xml\network_security_config.xml"
                     Link="Platforms\Android\Resources\xml\network_security_config.xml"
                     LogicalName="xml\network_security_config.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icône et écran de démarrage : générés pour chaque plateforme à partir des SVG. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F3A5F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F3A5F" BaseSize="128,128" />
  </ItemGroup>

  <!-- Microsoft.Identity.Client.NativeInterop (tiré par SQL Server, inutilisé sur le poste) ajoute à tout projet MAUI
       construit sur un Mac sa bibliothèque macOS, que l'éditeur de liens refuse pour iOS et Mac Catalyst. -->
  <Target Name="LettraSansMsalRuntime" BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <ItemGroup>
      <NativeReference Remove="@(NativeReference)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('msalruntime'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Composition\Lettra.Bootstrap\Lettra.Bootstrap.csproj" />
    <ProjectReference Include="..\..\Composition\Lettra.DemoData\Lettra.DemoData.csproj" />
    <ProjectReference Include="..\..\Presentation\Lettra.UI.Shared\Lettra.UI.Shared.csproj" />
    <ProjectReference Include="..\..\Presentation\Lettra.UI.Gateway.InProcess\Lettra.UI.Gateway.InProcess.csproj" />
    <ProjectReference Include="..\..\Presentation\Lettra.UI.Gateway.Http\Lettra.UI.Gateway.Http.csproj" />
    <ProjectReference Include="..\..\Modules\Sync\Lettra.Sync.Client\Lettra.Sync.Client.csproj" />
    <!-- Voix sur le poste (Whisper.net) : dictée et commandes transcrites sur l'appareil, hors ligne. -->
    <ProjectReference Include="..\..\Infrastructure\Lettra.Infrastructure.Speech.OnDevice\Lettra.Infrastructure.Speech.OnDevice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <!-- Bibliothèques natives de whisper.cpp, choisies par les cibles du paquet pour chaque plateforme : Android
         (arm64-v8a et x86_64, les architectures de l'APK), iOS (appareil et
         simulateur), Mac Catalyst, Windows (x64, x86, arm64). Directement ici : ces cibles ne s'appliquent qu'à un
         projet qui référence le paquet lui-même. -->
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
