{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Lettra": {
    "DeploymentMode": "HostedSaaS",
    "Catalog": { "Provider": "PostgreSql" },
    "Worker": { "RunOnce": false, "Interval": "00:15:00", "CanarySize": 25, "MaxParallelism": 16, "Escalation": { "Enabled": true, "Interval": "00:01:00" },
      "RecurringInvoices": { "Enabled": true, "Interval": "06:00:00", "InitialDelay": "00:03:00" } }
  }
}
