<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core Minimal APIs (modes 2 à 5). Sert aussi l'application WASM. -->
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1515 : Program est public pour WebApplicationFactory. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Composition\Lettra.Bootstrap\Lettra.Bootstrap.csproj" />
    <ProjectReference Include="..\Lettra.Web\Lettra.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lettra.Api.Tests" />
  </ItemGroup>

</Project>
