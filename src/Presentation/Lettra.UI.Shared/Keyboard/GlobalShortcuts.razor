@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ShortcutRegistry Registry
@* Pousse une portée de raccourcis (ex. Ctrl+Shift+D densité) et l'écoute sur tout le document. *@

@code {
    [Parameter, EditorRequired] public KeyboardScope Scope { get; set; } = default!;

    private IDisposable? _registration;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<GlobalShortcuts>? _self;

    protected override void OnInitialized() => _registration = Registry.PushScope(Scope);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", GridKeyboardModule.Path);
        _self = DotNetObjectReference.Create(this);
        if (_module is not null)
        {
            _handle = await _module.InvokeAsync<IJSObjectReference>("attachGlobal", _self, ShortcutRegistry.KeysOf(Scope));
        }
    }

    [JSInvokable]
    public Task OnShortcut(string chord) =>
        InvokeAsync(() => Registry.TryHandleAsync(KeyChord.Parse(chord), CommandContext.None));

    public async ValueTask DisposeAsync()
    {
        _registration?.Dispose();
        await JsModules.ReleaseAsync(_handle, "dispose");
        await JsModules.ReleaseAsync(_module);

        _self?.Dispose();
    }
}
