@* Coquille de l'application (vague 5, lane B), pensée pour chaque appareil :
   - ordinateur (≥ 1200 px) : barre latérale, repliable en rail ;
   - tablette (768 à 1199 px) : rail d'icônes ;
   - téléphone (< 768 px) : barre du haut compacte et onglets en bas (Accueil, Devis, Factures, Clients, Plus), la feuille
     « Plus » portant le reste de la navigation, l'aide et l'apparence. Zones sûres iOS et cibles tactiles de 44 px.
   Le menu (NavMenu) défile seul, sans barre horizontale ; l'aide et le repli restent en bas de la barre latérale. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject UiPreferences Preferences
@inject AssistantPanelState Assistant
@inject HelpPanelState Help
@inject NavigationManager Navigation
@inject Lettra.UI.Shared.Cabinet.CurrentDossier Dossier
@inject SessionState Session
@inject Lettra.UI.Shared.Voice.VoiceInput Voice
@inject Lettra.UI.Shared.Preferences.PreferencesSync AccountPreferences

<DeviceLockGate>
<CascadingValue Value="Preferences.Density">
    <div class="lettra-shell lt-shell @Preferences.Density.CssClass()" data-nav="@(Preferences.NavCollapsed ? "collapsed" : "expanded")">
        <a class="lt-skip" href="@SkipLink">@L["Shell.SkipToContent"]</a>

        <aside class="lt-sidebar" aria-label="@L["Nav.Label"]">
            <a class="lt-brand" href="" title="Lettra">
                <span class="lt-brand-mark" aria-hidden="true">L</span>
                <span class="lt-brand-name">Lettra</span>
            </a>
            <nav aria-label="@L["Nav.Label"]">
                <NavMenu Id="nav" OnSearchEverywhere="SearchEverywhereAsync" />
            </nav>
            <div class="lt-sidebar-footer">
                <button type="button" id="nav-help" class="lt-sidebar-action" aria-haspopup="dialog" aria-controls="help-panel"
                        aria-label="@L["Help.Menu"]" title="@L["Help.Menu"]" @onclick="() => Help.Open()">
                    <Icon Name="circle-help" />
                    <span class="lt-nav-label">@L["Help.Menu"]</span>
                </button>
                <button type="button" id="nav-collapse" class="lt-sidebar-action lt-nav-collapse" aria-pressed="@(Preferences.NavCollapsed ? "true" : "false")"
                        aria-label="@L[Preferences.NavCollapsed ? "Shell.ExpandNav" : "Shell.CollapseNav"]" title="@L[Preferences.NavCollapsed ? "Shell.ExpandNav" : "Shell.CollapseNav"]"
                        @onclick="Preferences.ToggleNavAsync">
                    <Icon Name="@(Preferences.NavCollapsed ? "chevrons-right" : "chevrons-left")" />
                    <span class="lt-nav-label">@L["Shell.CollapseNav"]</span>
                </button>
            </div>
        </aside>

        <div class="lt-frame">
            <header class="lettra-header lt-topbar">
                <a class="lt-brand lt-topbar-brand" href="" title="Lettra">
                    <span class="lt-brand-mark" aria-hidden="true">L</span>
                    <span class="lettra-visually-hidden">Lettra</span>
                </a>
                <SessionGate Redirect="false"><Lettra.UI.Shared.Components.Cabinet.DossierPicker /></SessionGate>
                <button type="button" id="palette-open" class="lettra-palette-button lt-search" @onclick="OpenPaletteAsync" title="@L["Palette.Title"] (Ctrl+K)">
                    <Icon Name="search" Size="18" />
                    <span class="lt-search-label">@L["Shell.Search"]</span>
                    <kbd>Ctrl K</kbd>
                </button>
                <div class="lt-topbar-actions">
                    @if (Assistant.IsAvailable)
                    {
                        <button type="button" id="assistant-toggle" class="lt-icon-button" aria-expanded="@(Assistant.IsOpen ? "true" : "false")"
                                aria-label="@L["Assistant.Open"]" title="@L["Assistant.Open"]" @onclick="Assistant.Toggle">
                            <Icon Name="sparkles" />
                        </button>
                    }
                    <SyncBadge />
                    <VoiceButton />
                    <TourHelpButton />
                    <AppearanceMenu />
                    <div class="lettra-session"><SessionBar /></div>
                </div>
            </header>

            <main id="main" class="lettra-main lt-main" tabindex="-1">
                <SyncReminderBanner />
                <OfflineDraftsBanner />
                @* Changer de dossier recrée l'écran : chaque page relit ses données dans le nouveau dossier. Quand
                   l'utilisateur peut changer de dossier, l'écran attend la liste de ses dossiers, qui garde le dossier
                   ouvert s'il y est, sinon en ouvre un autre (première connexion en ligne, dossier de la configuration
                   inaccessible, dossier fermé) : aucune page ne lit un dossier qu'il ne peut pas ouvrir. *@
                <SessionGate @key="Dossier.Id">
                    @if (WaitingForDossier)
                    {
                        <p class="lettra-muted" aria-busy="true" id="dossier-waiting">@L["Loading"]</p>
                    }
                    else
                    {
                        @Body
                    }
                </SessionGate>
            </main>
            <ToastHost />
            <DemoHost />
        </div>

        <nav class="lt-tabbar" aria-label="@L["Shell.TabBar"]">
            @foreach (NavItem item in NavItems.All.Where(i => i.InTabBar))
            {
                <NavLink href="@item.Href" Match="item.Match" class="lt-tab">
                    <Icon Name="@item.Icon" Size="22" />
                    <span>@L[item.LabelKey]</span>
                </NavLink>
            }
            <button type="button" id="tab-more" class="lt-tab" aria-expanded="@(_moreOpen ? "true" : "false")" aria-controls="more-sheet" @onclick="ToggleMore">
                <Icon Name="ellipsis" Size="22" />
                <span>@L["Shell.More"]</span>
            </button>
        </nav>

        @if (_moreOpen)
        {
            <div class="lt-sheet-backdrop" @onclick="CloseMore"></div>
            <div id="more-sheet" class="lt-sheet" role="dialog" aria-modal="true" aria-labelledby="more-sheet-title" @onkeydown="OnSheetKeyDown">
                <div class="lt-sheet-header">
                    <h2 id="more-sheet-title">@L["Shell.More"]</h2>
                    <button type="button" class="lt-icon-button" aria-label="@L["Shell.Close"]" @onclick="CloseMore"><Icon Name="x" /></button>
                </div>
                <nav aria-label="@L["Nav.Label"]">
                    <NavMenu Id="more" Items="NavItems.All.Where(i => !i.InTabBar)" OnNavigate="CloseMore" OnSearchEverywhere="SearchEverywhereAsync" />
                </nav>
                <button type="button" id="more-help" class="lt-sheet-help" @onclick="OpenHelpFromSheet">
                    <Icon Name="circle-help" />
                    <span class="lt-nav-label">@L["Help.Menu"]</span>
                </button>
                <AppearanceMenu Inline="true" />
            </div>
        }

        <SyncConsentPanel />
        @* L'assistant et la dictée lisent l'état du dossier ouvert : comme l'écran, ils attendent qu'il soit connu. *@
        <SessionGate Redirect="false">
            @if (!WaitingForDossier)
            {
                <AssistantPanel />
            }
        </SessionGate>
    </div>
</CascadingValue>

<GlobalShortcuts Scope="_globalScope" />
<CommandPalette @ref="_palette" />
<HelpPanel OnSearchEverywhere="SearchEverywhereAsync" />
<TourHost />
@* Hors de toute garde de session : la dictée attend aussi la liste des dossiers, qui ne se lit qu'une session ouverte. *@
@if (!(Dossier.CanSwitch && !Dossier.IsLoaded))
{
    <VoiceHost />
}
</DeviceLockGate>

@code {
    private KeyboardScope _globalScope = default!;
    private CommandPalette? _palette;
    private bool _moreOpen;
    private Guid? _shownDossier;

    // Lien d'évitement vers le contenu, relatif à la page courante (la base <base href> le résoudrait vers l'accueil).
    private string SkipLink => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0] + "#main";

    protected override void OnInitialized()
    {
        // Portée globale : la plus générale, les pages l'enrichissent ou la masquent.
        _globalScope = new KeyboardScope("global")
            .Bind(CommandPalette.Shortcut.ToString(), L["Palette.Title"], _ => OpenPaletteAsync(), showInBar: false)
            .Bind("Ctrl+Shift+D", L["Command.Density"], _ => Preferences.ToggleDensityAsync(), showInBar: false);
        Preferences.Changed += OnPreferencesChanged;
        Assistant.Changed += OnPreferencesChanged;
        Dossier.Changed += OnDossierChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _shownDossier = Dossier.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Preferences.LoadAsync();
            await AccountPreferences.StartAsync();
        }
    }

    private bool WaitingForDossier => Session.IsAuthenticated && Dossier.CanSwitch && !Dossier.IsLoaded;

    private Task OpenPaletteAsync() => _palette?.OpenAsync() ?? Task.CompletedTask;

    private Task SearchEverywhereAsync(string query) => _palette?.OpenAsync(query) ?? Task.CompletedTask;

    private void OpenHelpFromSheet()
    {
        CloseMore();
        Help.Open();
    }

    private void ToggleMore() => _moreOpen = !_moreOpen;

    private void CloseMore() => _moreOpen = false;

    private void OnSheetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMore();
        }
    }

    private void OnPreferencesChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    // Un autre dossier ouvert : l'assistant et la dictée relisent leur état dans ce dossier (droits, réglages).
    private void OnDossierChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        if (Dossier.Id != _shownDossier)
        {
            _shownDossier = Dossier.Id;
            Task assistant = Assistant.LoadAsync(refresh: true);
            Task voice = Voice.LoadAsync(refresh: true);
            await Task.WhenAll(assistant, voice);
        }

        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_moreOpen)
        {
            _moreOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Assistant.Changed -= OnPreferencesChanged;
        Dossier.Changed -= OnDossierChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
