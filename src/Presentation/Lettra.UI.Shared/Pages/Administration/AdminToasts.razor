@* Messages brefs en bas de l'écran, avec une action « Annuler » quand le geste se défait. Remplacé par le toaster
   partagé du design system dès qu'il est sur main. *@
@implements IDisposable
@inject IStringLocalizer<SharedResource> L

<div class="la-toasts" role="status" aria-live="polite">
    @foreach (Toast toast in _toasts)
    {
        <div class="la-toast @(toast.IsError ? "is-error" : null)" @key="toast">
            <Icon Name="@(toast.IsError ? "triangle-alert" : "check")" Size="18" />
            <span>@toast.Text</span>
            @if (toast.Undo is not null)
            {
                <button type="button" class="la-toast-action" @onclick="() => UndoAsync(toast)"><Icon Name="undo-2" Size="16" />@L["Admin.Undo"]</button>
            }
            <button type="button" class="la-toast-close" aria-label="@L["Shell.Close"]" @onclick="() => Remove(toast)"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    private readonly List<Toast> _toasts = [];
    private readonly CancellationTokenSource _disposed = new();

    public void Show(string text, Func<Task>? undo = null) => Add(new Toast(text, false, undo));

    public void ShowError(string text) => Add(new Toast(text, true, null));

    private void Add(Toast toast)
    {
        _toasts.Add(toast);
        if (_toasts.Count > 3)
        {
            _toasts.RemoveAt(0);
        }

        StateHasChanged();
        _ = ExpireAsync(toast);
    }

    private async Task ExpireAsync(Toast toast)
    {
        try
        {
            await Task.Delay(toast.Undo is null ? 5000 : 8000, _disposed.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(() => Remove(toast));
    }

    private void Remove(Toast toast)
    {
        if (_toasts.Remove(toast))
        {
            StateHasChanged();
        }
    }

    private async Task UndoAsync(Toast toast)
    {
        Remove(toast);
        if (toast.Undo is not null)
        {
            await toast.Undo();
        }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }

    private sealed record Toast(string Text, bool IsError, Func<Task>? Undo);
}
