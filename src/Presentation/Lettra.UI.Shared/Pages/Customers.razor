@page "/"
@page "/customers"
@inject ICustomersGateway Gateway
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Customers.Title"] · Lettra</PageTitle>

<h1 tabindex="-1">@L["Customers.Title"]</h1>

<section aria-labelledby="create-title" class="lettra-card">
    <h2 id="create-title">@L["Customers.Create.Title"]</h2>

    <EditForm Model="_request" OnValidSubmit="CreateAsync" FormName="create-customer">
        <DataAnnotationsValidator />

        <fieldset>
            <legend>@L["Customers.Field.Kind"]</legend>
            <InputRadioGroup @bind-Value="_request.Kind">
                <label><InputRadio Value="CustomerKindDto.Company" /> @L["Customers.Kind.Company"]</label>
                <label><InputRadio Value="CustomerKindDto.Individual" /> @L["Customers.Kind.Individual"]</label>
            </InputRadioGroup>
        </fieldset>

        <label for="name">@L["Customers.Field.Name"]</label>
        <InputText id="name" @bind-Value="_request.Name" autocomplete="organization" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.Name)" ServerErrors="_errors" />

        @if (_request.Kind == CustomerKindDto.Company)
        {
            <label for="siret">@L["Customers.Field.Siret"]</label>
            <InputText id="siret" @bind-Value="_request.Siret" inputmode="numeric" />
            <FieldErrors Field="@nameof(CreateCustomerRequest.Siret)" ServerErrors="_errors" />

            <label for="siren">@L["Customers.Field.Siren"]</label>
            <InputText id="siren" @bind-Value="_request.Siren" inputmode="numeric" />
            <FieldErrors Field="@nameof(CreateCustomerRequest.Siren)" ServerErrors="_errors" />

            <label for="vat">@L["Customers.Field.VatNumber"]</label>
            <InputText id="vat" @bind-Value="_request.VatNumber" />
            <FieldErrors Field="@nameof(CreateCustomerRequest.VatNumber)" ServerErrors="_errors" />
        }

        <label for="email">@L["Customers.Field.Email"]</label>
        <InputText id="email" type="email" @bind-Value="_request.Email" autocomplete="email" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.Email)" ServerErrors="_errors" />

        <label for="line1">@L["Customers.Field.AddressLine1"]</label>
        <InputText id="line1" @bind-Value="_request.AddressLine1" autocomplete="address-line1" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.AddressLine1)" ServerErrors="_errors" />

        <label for="line2">@L["Customers.Field.AddressLine2"]</label>
        <InputText id="line2" @bind-Value="_request.AddressLine2" autocomplete="address-line2" />

        <label for="zip">@L["Customers.Field.PostalCode"]</label>
        <InputText id="zip" @bind-Value="_request.PostalCode" autocomplete="postal-code" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.PostalCode)" ServerErrors="_errors" />

        <label for="city">@L["Customers.Field.City"]</label>
        <InputText id="city" @bind-Value="_request.City" autocomplete="address-level2" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.City)" ServerErrors="_errors" />

        <label for="country">@L["Customers.Field.CountryCode"]</label>
        <InputText id="country" @bind-Value="_request.CountryCode" maxlength="2" autocomplete="country" />
        <FieldErrors Field="@nameof(CreateCustomerRequest.CountryCode)" ServerErrors="_errors" />

        @foreach (ErrorDetail error in _errors.Where(e => e.Target is null))
        {
            <p class="validation-message" role="alert">@L.Error(error.Code)</p>
        }

        <button type="submit" disabled="@_busy">@L["Customers.Create.Submit"]</button>

        @if (_created is not null)
        {
            <p role="status" class="lettra-success">@string.Format(CultureInfo.CurrentCulture, L["Customers.Create.Done"], _created.Name)</p>
        }
    </EditForm>
</section>

<section aria-labelledby="list-title" class="lettra-card">
    <h2 id="list-title">@L["Customers.List.Title"]</h2>
    @if (_page is null)
    {
        <p>@L["Loading"]</p>
    }
    else if (_page.TotalCount == 0)
    {
        <p>@L["Customers.List.Empty"]</p>
    }
    else
    {
        <table class="lettra-table">
            <thead>
                <tr>
                    <th scope="col">@L["Customers.Field.Name"]</th>
                    <th scope="col">@L["Customers.Field.Siren"]</th>
                    <th scope="col">@L["Customers.Field.City"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CustomerSummary customer in _page.Items)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.Siren</td>
                        <td>@customer.City</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private CreateCustomerRequest _request = new();
    private IReadOnlyList<ErrorDetail> _errors = [];
    private PagedResponse<CustomerSummary>? _page;
    private CustomerResponse? _created;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task CreateAsync()
    {
        _busy = true;
        _created = null;
        try
        {
            OperationResult<CustomerResponse> result = await Gateway.CreateAsync(_request, CancellationToken.None);
            if (result.IsSuccess)
            {
                _created = result.Value;
                _errors = [];
                _request = new CreateCustomerRequest();
                await LoadAsync();
            }
            else
            {
                _errors = result.Errors;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        OperationResult<PagedResponse<CustomerSummary>> result = await Gateway.ListAsync(1, 50, CancellationToken.None);
        if (result.IsSuccess)
        {
            _page = result.Value;
        }
        else
        {
            _errors = result.Errors;
            _page = new PagedResponse<CustomerSummary>([], 1, 50, 0);
        }
    }
}
