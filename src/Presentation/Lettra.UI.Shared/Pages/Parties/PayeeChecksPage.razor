@page "/iban-changes/payees"
@inject IIbanChangesGateway Changes
@inject ISuppliersGateway Suppliers
@inject ToastService Toasts
@inject IStringLocalizer<SharedResource> L
@* Nom et IBAN vérifiés : avant de payer un fournisseur, son nom doit être celui du titulaire du compte. Le contrôle local
   compare le titulaire saisi au nom du fournisseur ; la vérification du bénéficiaire interroge la banque (simulée).
   Par défaut, seuls les bénéficiaires à contrôler, les plus à risque en tête. *@

<PageTitle>@L["Payees.Title"] · Lettra</PageTitle>

<div class="lt-page-header">
    <div>
        <h1 tabindex="-1">@L["Payees.Title"]</h1>
        <p class="lettra-muted">@L["Payees.Subtitle"]</p>
    </div>
    <div class="lt-page-actions">
        <a class="lettra-button is-secondary" href="suppliers" id="payees-to-suppliers"><Icon Name="truck" Size="18" /> @L["Suppliers.Title"]</a>
    </div>
</div>

<IbanTabs />

<section class="lettra-card" aria-labelledby="payees-list-title">
    <h2 id="payees-list-title" class="lettra-visually-hidden">@L["Payees.Title"]</h2>
    <ListFilterBar Id="payees-filters" ActiveCount="ActiveFilters" OnReset="ResetFiltersAsync">
        <ChildContent>
            <div class="lt-filter">
                <label for="payees-search">@L["IbanChanges.Search"]</label>
                <input id="payees-search" type="search" @bind="_search" @bind:after="ReloadAsync" autocomplete="off" />
            </div>
        </ChildContent>
        <More>
            <label class="lt-banking-check">
                <input id="payees-only-review" type="checkbox" @bind="_onlyToReview" @bind:after="ReloadAsync" />
                <span>@L["Payees.OnlyToReview"]</span>
            </label>
            <SortSelect Id="payees-sort" Options="SortOptions" State="_sort" OnSort="ReloadAsync" />
        </More>
    </ListFilterBar>

    <GeneralErrors Errors="_errors" IncludeFieldErrors="true" />

    @if (_page is null)
    {
        <ListSkeleton Columns="5" />
    }
    else if (_page.Items.Count == 0 && ActiveFilters > 0)
    {
        <EmptyState Id="payees-filtered-empty" IconName="search" Title="@L["Lists.Empty.FilteredTitle"]" Text="@L["Lists.Empty.Filtered"]">
            <button type="button" class="lettra-button is-secondary" id="payees-empty-reset" @onclick="ResetFiltersAsync">@L["Lists.Filters.Reset"]</button>
        </EmptyState>
    }
    else if (_page.Items.Count == 0)
    {
        <EmptyState Id="payees-empty" IconName="shield-check" Title="@L["Payees.Empty"]" Text="@L["Payees.Empty.Text"]">
            <button type="button" class="lettra-button is-secondary" id="payees-show-all" @onclick="ShowAllAsync">@L["Payees.ShowAll"]</button>
        </EmptyState>
    }
    else
    {
        <div class="lt-list-scroll">
            <table class="lettra-table lettra-documents lt-cards" id="payees-table">
                <thead>
                    <tr>
                        <SortHeader Option="Column(PayeeCheckSortDto.Name)" State="_sort" OnSort="ReloadAsync" Id="payees-sort-name" />
                        <th scope="col">@L["Suppliers.Field.AccountHolder"]</th>
                        <th scope="col">@L["Suppliers.Field.Iban"]</th>
                        <SortHeader Option="Column(PayeeCheckSortDto.Risk)" State="_sort" OnSort="ReloadAsync" Id="payees-sort-risk" />
                        <th scope="col"><span class="lettra-visually-hidden">@L["IbanChanges.Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PayeeCheckRowResponse row in _page.Items)
                    {
                        <tr @key="row.SupplierId" data-supplier="@row.SupplierId">
                            <td>
                                <span class="lt-iban-cell">
                                    <a href="@($"suppliers/{row.SupplierId}")">@row.Name</a>
                                    @if (row.AttestationDue)
                                    {
                                        <a class="lettra-status is-refused" href="attestations" id="@($"payee-attestation-{row.SupplierId}")">@L["Payees.AttestationDue"]</a>
                                    }
                                </span>
                            </td>
                            <td data-label="@L["Suppliers.Field.AccountHolder"]">
                                <span class="lt-iban-cell">
                                    <span>@(row.AccountHolderName ?? L["Payees.SameAsName"])</span>
                                    @if (row.HolderNameMatch is PayeeMatchDto.NoMatch or PayeeMatchDto.CloseMatch)
                                    {
                                        <span class="lettra-status @(row.HolderNameMatch == PayeeMatchDto.NoMatch ? "is-refused" : "is-draft")">@L[$"Payees.Holder.{row.HolderNameMatch}"]</span>
                                    }
                                </span>
                            </td>
                            <td data-label="@L["Suppliers.Field.Iban"]">
                                <span class="lt-iban-cell">
                                    <span class="lt-iban">@row.MaskedIban</span>
                                    @if (row.IbanChangePending)
                                    {
                                        <a class="lettra-status is-refused" href="iban-changes"><Icon Name="shield-alert" Size="14" /> @L["Payees.IbanChanged"]</a>
                                    }
                                </span>
                            </td>
                            <td data-label="@L["Payees.Check"]">
                                <span class="lt-iban-cell">
                                    @if (row.Check is { } check)
                                    {
                                        <span class="lettra-status @SuppliersPage.PayeeStatusClass(check.Result)">@L[$"Payees.Result.{check.Result}"]</span>
                                        @if (check.SuggestedName is { } suggested)
                                        {
                                            <span>@string.Format(Culture, L["Payees.Suggested"], suggested)</span>
                                        }
                                        <span class="lettra-muted">@check.CheckedAt.ToLocalTime().ToString("g", Culture)</span>
                                    }
                                    else
                                    {
                                        <span class="lettra-muted">@L["Payees.NeverChecked"]</span>
                                    }
                                </span>
                            </td>
                            <td>
                                <button type="button" class="lettra-button is-secondary" id="@($"payee-verify-{row.SupplierId}")" disabled="@(_verifying == row.SupplierId)"
                                        @onclick="() => VerifyAsync(row)">
                                    @L["Payees.Verify"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_page.TotalCount > _page.PageSize)
        {
            <nav class="lt-pager" aria-label="@L["Accounting.Pages"]">
                <button type="button" class="lettra-button is-secondary" disabled="@(_pageNumber <= 1)" @onclick="() => GoToAsync(_pageNumber - 1)">@L["Accounting.Previous"]</button>
                <span>@string.Format(Culture, L["Accounting.PageOf"], _pageNumber, PageCount)</span>
                <button type="button" class="lettra-button is-secondary" disabled="@(_pageNumber >= PageCount)" @onclick="() => GoToAsync(_pageNumber + 1)">@L["Accounting.Next"]</button>
            </nav>
        }
    }
    <p class="lettra-hint">@L["Payees.Simulated"]</p>
</section>

@code {
    private const int PageSize = 50;

    private PagedResponse<PayeeCheckRowResponse>? _page;
    private IReadOnlyList<ErrorDetail> _errors = [];
    private string? _search;
    private bool _onlyToReview = true;
    private int _pageNumber = 1;
    private Guid? _verifying;

    // Tri sur le serveur : les plus à risque en tête par défaut.
    private readonly SortState<PayeeCheckSortDto> _sort = new(PayeeCheckSortDto.Risk, SortDirectionDto.Ascending);

    private IReadOnlyList<SortOption<PayeeCheckSortDto>> SortOptions =>
    [
        new(PayeeCheckSortDto.Name, L["IbanChanges.Supplier"]),
        new(PayeeCheckSortDto.Risk, L["Payees.Check"]),
    ];

    private SortOption<PayeeCheckSortDto> Column(PayeeCheckSortDto column) => SortOptions.First(o => o.Column == column);

    /// <summary>La recherche, et la case « à contrôler » si elle est décochée.</summary>
    private int ActiveFilters => (string.IsNullOrWhiteSpace(_search) ? 0 : 1) + (_onlyToReview ? 0 : 1);

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private int PageCount => _page is null ? 1 : Math.Max(1, (int)Math.Ceiling(_page.TotalCount / (double)_page.PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        OperationResult<PagedResponse<PayeeCheckRowResponse>> result = await Changes.ListPayeesAsync(
            new PayeeCheckListQuery(_onlyToReview, _search, _pageNumber, PageSize, _sort.Column, _sort.Direction), CancellationToken.None);
        _errors = result.Errors;
        _page = result.Value ?? new PagedResponse<PayeeCheckRowResponse>([], 1, PageSize, 0);
    }

    private Task ReloadAsync() => GoToAsync(1);

    private Task ResetFiltersAsync()
    {
        (_search, _onlyToReview) = (null, true);
        return ReloadAsync();
    }

    private Task ShowAllAsync()
    {
        _onlyToReview = false;
        return ReloadAsync();
    }

    private async Task GoToAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task VerifyAsync(PayeeCheckRowResponse row)
    {
        _verifying = row.SupplierId;
        try
        {
            OperationResult<PayeeCheckResponse> result = await Suppliers.VerifyPayeeAsync(row.SupplierId, CancellationToken.None);
            if (!result.IsSuccess || result.Value is not { } check)
            {
                Toasts.Show(ToastKind.Error, string.Join(" ", result.Errors.Select(e => L.Error(e.Code))));
                return;
            }

            Toasts.Show(
                check.Result == PayeeMatchDto.Match ? ToastKind.Success : ToastKind.Warning,
                string.Format(Culture, L["Payees.Verified"], row.Name, L[$"Payees.Result.{check.Result}"]));
            await LoadAsync();
        }
        finally
        {
            _verifying = null;
        }
    }
}
