@page "/quotes/new"
@page "/quotes/{Id:guid}"
@page "/quotes/draft/{LocalId:guid}"
@using Lettra.Contracts.Serialization
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IQuotesGateway Quotes
@inject IBillingSettingsGateway Settings
@inject IServiceProvider Services
@inject IDocumentPdfRenderer Pdf
@inject IFileDownloader Files
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<SharedResource> L

<PageTitle>@Title · Lettra</PageTitle>

<h1 tabindex="-1">@Title <DocumentStatusBadge Text="@StatusText" Kind="@StatusKind" /></h1>

<GlobalShortcuts Scope="_pageScope" />

@if (_conflict)
{
    <div class="lettra-banner is-warning" role="alert">
        @L["Billing.Conflict"]
        <button type="button" class="lettra-button" @onclick="ReloadAsync">@L["Billing.Reload"]</button>
    </div>
}

<GeneralErrors Errors="_errors" />
<StatusToast Message="@_status" />

@if (_loading)
{
    <p>@L["Loading"]</p>
}
else
{
    <div class="lettra-document">
        <div class="lettra-document-main">
            <Collapsible @ref="_mainBlock" Id="quote-main" Title="@L["Billing.Section.Main"]" Summary="@MainSummary">
                <div class="lettra-document-header" role="group" aria-label="@L["Billing.Header"]">
                    <CustomerPicker @ref="_customerPicker" CustomerId="_request.CustomerId" SelectedName="@_customerName" ReadOnly="IsReadOnly"
                                    OnSelected="CustomerSelectedAsync" />

                    <div class="lettra-field">
                        <label for="valid-until">@L["Quote.Field.ValidUntil"]</label>
                        <DateField Id="valid-until" @ref="_validUntil" Disabled="IsReadOnly" Value="_request.ValidUntil" ValueChanged="ValidUntilChangedAsync" />
                    </div>

                    <div class="lettra-field">
                        <label for="vat-regime">@L["Billing.Field.VatRegime"]</label>
                        <select id="vat-regime" disabled="@IsReadOnly" value="@_request.VatRegime" @onchange="RegimeChangedAsync">
                            @foreach (VatRegimeOption regime in _reference.VatRegimes)
                            {
                                <option value="@regime.Regime">@L[$"VatRegime.{regime.Regime}"]</option>
                            }
                        </select>
                    </div>

                    <div class="lettra-field lettra-field-wide">
                        <label for="subject">@L["Billing.Field.Subject"]</label>
                        <SmartInput Id="subject" Voice="@(!IsReadOnly)" VoiceLabel="@L["Billing.Field.Subject"]" disabled="@IsReadOnly" Value="@_request.Subject" maxlength="200" OnCommitted="SubjectChangedAsync"
                                    Templates="TextFieldKind.Subject" Spellcheck="true" Tidy="true" />
                    </div>
                </div>
            </Collapsible>

            <Collapsible @ref="_linesBlock" Id="quote-lines" HeadingId="lines-title" Title="@L["Lines.Title"]" Summary="@LinesSummary">
                <DocumentLinesGrid @ref="_linesGrid" Lines="_lines" ReferenceData="_reference" Regime="_request.VatRegime"
                                   ReadOnly="IsReadOnly" ResolvePrice="ResolvePriceAsync"
                                   OnLinesChanged="ScheduleSaveAsync" OnTotalsChanged="TotalsChanged" />
                <CustomerHabits CustomerId="_request.CustomerId" Enabled="!IsReadOnly" Present="PresentItems"
                                OnAddItem="id => _linesGrid?.AddCatalogItemAsync(id) ?? Task.CompletedTask" />
            </Collapsible>

            <Collapsible Id="quote-notes" Title="@L["Billing.Field.Notes"]" Summary="@NotesSummary" InitiallyOpen="@(!string.IsNullOrEmpty(_request.Notes))"
                         Class="lettra-notes">
                <div class="lettra-field">
                    <label for="notes" class="lettra-visually-hidden">@L["Billing.Field.Notes"]</label>
                    <SmartInput Id="notes" Voice="@(!IsReadOnly)" VoiceLabel="@L["Billing.Field.Notes"]" Multiline="true" Rows="3" disabled="@IsReadOnly" Value="@_request.Notes" maxlength="4000" OnCommitted="NotesChangedAsync"
                                Templates="TextFieldKind.QuoteNotes" Spellcheck="true" Tidy="true" data-tour="notes" />
                </div>
            </Collapsible>
        </div>

        <aside class="lettra-document-side">
            <DocumentTotalsPanel Totals="_totals" />

            <div class="lettra-actions">
                @if (IsDraft)
                {
                    <button type="button" id="validate" class="lettra-button" disabled="@(!CanValidate)" @onclick="ValidateAsync"
                            title="@L["Billing.Command.Validate"] (Ctrl+Enter)">@L["Billing.Command.Validate"]</button>
                    <button type="button" id="save" class="lettra-button is-secondary" disabled="@_busy" @onclick="SaveNowAsync">@L["Billing.Command.Save"]</button>
                }
                @if (_quote?.Status == QuoteStatusDto.Validated)
                {
                    <button type="button" id="accept" class="lettra-button" @onclick="() => SetOutcomeAsync(true)">@L["Quote.Command.Accept"]</button>
                    <button type="button" class="lettra-button is-secondary" @onclick="() => SetOutcomeAsync(false)">@L["Quote.Command.Refuse"]</button>
                }
                @if (_quote?.Status == QuoteStatusDto.Accepted)
                {
                    <button type="button" id="final-invoice" class="lettra-button" @onclick="CreateInvoiceAsync">@L["Quote.Command.Invoice"]</button>
                    <div class="lettra-inline">
                        <label for="down-payment">@L["Quote.Field.DownPaymentPercent"]</label>
                        <input id="down-payment" inputmode="decimal" @bind="_downPaymentPercent" />
                        <button type="button" id="create-down-payment" class="lettra-button is-secondary" @onclick="CreateDownPaymentAsync">@L["Quote.Command.DownPayment"]</button>
                    </div>
                }
                <div class="lettra-inline">
                    <label for="pdf-language">@L["Billing.Field.PdfLanguage"]</label>
                    <select id="pdf-language" @bind="_pdfCulture">
                        <option value="fr-FR">Français</option>
                        <option value="en-US">English</option>
                    </select>
                    <button type="button" id="pdf" class="lettra-button is-secondary" disabled="@(_quote is null)" @onclick="DownloadPdfAsync"
                            title="@L["Billing.Command.Pdf"] (Ctrl+P)">@L["Billing.Command.Pdf"]</button>
                </div>
                @if (IsDraft && _quote is not null)
                {
                    <button type="button" class="lettra-link is-danger" @onclick="DeleteAsync">@L["Billing.Command.Delete"]</button>
                }
            </div>

            <ComplianceChecklist Report="_compliance" OnFindingSelected="FocusFindingAsync" DocumentId="Id" />
        </aside>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Brouillon gardé sur l'appareil faute de réseau, pas encore arrivé sur le serveur (étape 4.5).</summary>
    [Parameter] public Guid? LocalId { get; set; }

    [SupplyParameterFromQuery(Name = "customer")] public Guid? CustomerFromQuery { get; set; }

    /// <summary>Pause de saisie avant l'enregistrement du brouillon ; 0 dans les tests.</summary>
    [Parameter] public TimeSpan AutosaveDelay { get; set; } = TimeSpan.FromMilliseconds(800);

    private SaveQuoteRequest _request = new();
    private QuoteResponse? _quote;
    private List<DocumentLineRow> _lines = [];
    private BillingReferenceData _reference = new([], [], []);
    private DocumentTotals _totals = new([], 0m, 0m, 0m);
    private ComplianceReportResponse? _compliance;
    private CompanyProfileResponse? _company;
    private IReadOnlyList<ErrorDetail> _errors = [];
    private string? _status;
    private string? _customerName;
    private bool _loading = true;
    private bool _conflict;
    private bool _busy;
    private decimal? _downPaymentPercent = 30m;
    private string _pdfCulture = "fr-FR";
    private DraftAutosave _autosave = default!;
    private KeyboardScope _pageScope = default!;
    private CustomerPicker? _customerPicker;
    private DocumentLinesGrid? _linesGrid;
    private Collapsible? _mainBlock;
    private Collapsible? _linesBlock;
    private DateField? _validUntil;
    private Guid? _loadedId;
    private OfflineDrafts? _drafts;
    private Guid? _localId;

    private bool IsDraft => _quote is null || _quote.Status == QuoteStatusDto.Draft;

    private bool IsReadOnly => !IsDraft || _busy;

    private bool CanValidate => _quote is not null && !_busy && !_conflict && _compliance is { BlocksValidation: false };

    private string Title => _quote?.Number is { } number
        ? string.Format(CultureInfo.CurrentCulture, L["Quote.TitleNumber"], number)
        : L[_quote is null ? "Quote.TitleNew" : "Quote.TitleDraft"];

    /// <summary>Résumé du bloc replié : client, validité, régime.</summary>
    private string MainSummary => BillingSummaries.Join(
        _customerName ?? L["Billing.Summary.NoCustomer"].Value,
        _request.ValidUntil is { } until ? string.Format(CultureInfo.CurrentCulture, L["Quote.Summary.ValidUntil"], until.ToString("d", CultureInfo.CurrentCulture)) : null,
        L[$"VatRegime.{_request.VatRegime}"].Value);

    private string LinesSummary => BillingSummaries.Lines(L, _lines.Count, _totals.TotalExclTax);

    private string NotesSummary => BillingSummaries.Excerpt(_request.Notes) ?? L["Billing.Summary.NoNotes"].Value;

    private string StatusText => L[$"QuoteStatus.{_quote?.Status ?? QuoteStatusDto.Draft}"];

    private string StatusKind => (_quote?.Status ?? QuoteStatusDto.Draft).ToString().ToLowerInvariant();

    protected override void OnInitialized()
    {
        _autosave = new DraftAutosave(SaveAsync, AutosaveDelay);
        _pageScope = new KeyboardScope("page")
            .Bind("Ctrl+S", L["Billing.Command.Save"], _ => SaveNowAsync(), _ => IsDraft)
            .Bind("Ctrl+Enter", L["Billing.Command.Validate"], _ => ValidateAsync(), _ => CanValidate)
            .Bind("Ctrl+P", L["Billing.Command.Pdf"], _ => DownloadPdfAsync(), _ => _quote is not null);
        _drafts = Services.GetService<OfflineDrafts>();
        if (_drafts is not null)
        {
            _drafts.Synced += DraftSynced;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == (Id ?? LocalId) && !_loading)
        {
            return;
        }

        _loadedId = Id ?? LocalId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errors = [];
        _conflict = false;
        _autosave.Discard();
        _localId = null;
        _status = null;

        OperationResult<BillingReferenceData> reference = await Settings.GetReferenceDataAsync(CancellationToken.None);
        _reference = (_drafts is null ? reference.Value
            : await _drafts.CachedAsync(OfflineDrafts.ReferenceDataKey, reference, ContractsJsonContext.Default.BillingReferenceData, CancellationToken.None))
            ?? _reference;
        OperationResult<CompanyProfileResponse> company = await Settings.GetCompanyProfileAsync(CancellationToken.None);
        _company = _drafts is null ? company.Value
            : await _drafts.CachedAsync(OfflineDrafts.CompanyProfileKey, company, ContractsJsonContext.Default.CompanyProfileResponse, CancellationToken.None);

        if (Id is { } id)
        {
            OperationResult<QuoteResponse> loaded = await Quotes.GetAsync(id, CancellationToken.None);
            if (loaded.Value is null)
            {
                _errors = loaded.Errors;
                _loading = false;
                return;
            }

            Show(loaded.Value, replaceLines: true);
            await RestoreAsync(serverId: id, localId: null);
            await CheckAsync();
        }
        else if (LocalId is { } localId)
        {
            if (_drafts?.SyncedServerId(localId) is { } sent)
            {
                Navigation.NavigateTo($"quotes/{sent}", new NavigationOptions { ReplaceHistoryEntry = true });
                return;
            }

            _quote = null;
            _compliance = null;
            if (!await RestoreAsync(serverId: null, localId))
            {
                _status = L["Drafts.NotFound"];
            }
        }
        else
        {
            _quote = null;
            _request = new SaveQuoteRequest { VatRegime = _company?.VatFranchise == true ? VatRegimeDto.Franchise : VatRegimeDto.Standard };
            _lines = [];
            _compliance = null;
            _customerName = null;
            if (CustomerFromQuery is { } customerId)
            {
                _request.CustomerId = customerId;
            }
        }

        await PreselectPdfLanguageAsync();
        _loading = false;
    }

    /// <summary>
    /// Reprend la saisie gardée sur l'appareil : pour une pièce du serveur, seulement si elle s'appuie sur sa version
    /// actuelle (sinon l'envoi signalera le conflit) ; le prochain enregistrement en ligne la retire de l'appareil.
    /// </summary>
    private async Task<bool> RestoreAsync(Guid? serverId, Guid? localId)
    {
        if (_drafts is null
            || await _drafts.FindAsync(OfflineDraftKind.Quote, serverId, localId, CancellationToken.None) is not { } draft
            || (_quote is not null && draft.BaseVersion != _quote.Version)
            || OfflineDrafts.QuoteRequestOf(draft) is not { } request)
        {
            return false;
        }

        _localId = draft.LocalId;
        _request = request;
        _customerName = draft.Title ?? _customerName;
        _lines = [.. request.Lines.Select(l => DocumentLineRow.From(l,
            _reference.VatRates.FirstOrDefault(r => r.Code == l.VatRateCode)?.Percent ?? 0m))];
        _status = L["Drafts.Restored"];
        return true;
    }

    private void DraftSynced(object? sender, OfflineDraftSynced synced)
    {
        if (synced.Kind != OfflineDraftKind.Quote || synced.LocalId != _localId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _localId = null;
            if (_quote?.Id == synced.ServerId)
            {
                await ReloadAsync();
                StateHasChanged();
            }
            else
            {
                Navigation.NavigateTo($"quotes/{synced.ServerId}", new NavigationOptions { ReplaceHistoryEntry = true });
            }
        });
    }

    private void Show(QuoteResponse quote, bool replaceLines)
    {
        _quote = quote;
        _customerName = quote.Customer.Name;
        _request = new SaveQuoteRequest
        {
            CustomerId = quote.CustomerId,
            ValidUntil = quote.ValidUntil,
            VatRegime = quote.VatRegime,
            Subject = quote.Subject,
            Notes = quote.Notes,
            Lines = [.. quote.Lines.Select(l => DocumentLineRow.From(l).ToRequest())],
        };
        if (replaceLines)
        {
            _lines = [.. quote.Lines.OrderBy(l => l.Position).Select(DocumentLineRow.From)];
        }

        _totals = ToTotals(quote.Totals);
    }

    internal static DocumentTotals ToTotals(DocumentTotalsResponse totals) =>
        new([.. totals.Breakdown.GroupBy(b => b.VatRatePercent)
                .Select(g => new VatBreakdownLine(g.Key, g.Sum(b => b.BaseExclTax), g.Sum(b => b.VatAmount)))],
            totals.TotalExclTax, totals.TotalVat, totals.TotalInclTax);

    // ---------- saisie de l'en-tête ----------

    private async Task CustomerSelectedAsync(CustomerSummary customer)
    {
        _request.CustomerId = customer.Id;
        _customerName = customer.Name;
        await PreselectPdfLanguageAsync();
        await ScheduleSaveAsync();
    }

    /// <summary>Langue du PDF proposée : celle du client, le français sinon (elle reste modifiable).</summary>
    private async Task PreselectPdfLanguageAsync()
    {
        if (_request.CustomerId == Guid.Empty || Services.GetService(typeof(ICustomersGateway)) is not ICustomersGateway customers)
        {
            return;
        }

        OperationResult<CustomerResponse> customer = await customers.GetAsync(_request.CustomerId, CancellationToken.None);
        _pdfCulture = customer.Value?.PreferredLanguage ?? "fr-FR";
    }

    private async Task ValidUntilChangedAsync(DateOnly? date)
    {
        _request.ValidUntil = date;
        await ScheduleSaveAsync();
    }

    private async Task RegimeChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out VatRegimeDto regime))
        {
            _request.VatRegime = regime;
            await ScheduleSaveAsync();
        }
    }

    private async Task SubjectChangedAsync(string value)
    {
        _request.Subject = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        await ScheduleSaveAsync();
    }

    private async Task NotesChangedAsync(string value)
    {
        _request.Notes = string.IsNullOrWhiteSpace(value) ? null : value;
        await ScheduleSaveAsync();
    }

    /// <summary>Articles déjà sur le devis : les suggestions du client ne les reproposent pas.</summary>
    private Guid[] PresentItems => [.. _lines.Where(l => l.CatalogItemId is not null).Select(l => l.CatalogItemId!.Value)];

    private void TotalsChanged(DocumentTotals totals) => _totals = totals;

    private async Task<ResolvedPrice?> ResolvePriceAsync(Guid catalogItemId)
    {
        if (_request.CustomerId == Guid.Empty || Services.GetService(typeof(IPriceListsGateway)) is not IPriceListsGateway prices)
        {
            return null;
        }

        OperationResult<IReadOnlyList<ResolvedPrice>> result = await prices.ResolveAsync(_request.CustomerId, [catalogItemId], CancellationToken.None);
        return result.Value?.FirstOrDefault();
    }

    // ---------- enregistrement du brouillon et checklist ----------

    private Task ScheduleSaveAsync() => IsDraft && !_conflict ? _autosave.ScheduleAsync() : Task.CompletedTask;

    /// <summary>
    /// Enregistrement demandé (bouton, Ctrl+S) : la pièce ne naît qu'avec son client et une ligne complète ; s'il en
    /// manque un, on le dit et on y place le curseur au lieu de laisser un bouton inactif sans explication.
    /// </summary>
    private async Task SaveNowAsync()
    {
        if (_quote is null && _request.CustomerId == Guid.Empty)
        {
            _errors = [new ErrorDetail(ErrorCodes.Billing.CustomerRequired)];
            await ExpandAsync(_mainBlock);
            if (_customerPicker is not null)
            {
                await _customerPicker.FocusAsync();
            }

            return;
        }

        if (_quote is null && _lines.All(l => l.IsIncomplete))
        {
            _errors = [new ErrorDetail(ErrorCodes.Billing.LinesRequired)];
            return;
        }

        await ScheduleSaveAsync();
        await _autosave.FlushAsync();
    }

    private async Task SaveAsync()
    {
        if (_request.CustomerId == Guid.Empty)
        {
            return;   // un brouillon naît avec son client
        }

        _request.Lines = [.. _lines.Where(l => !l.IsIncomplete).Select(l => l.ToRequest())];
        if (_quote is null && _request.Lines.Count == 0)
        {
            return;   // pas de pièce vide : elle naît avec sa première ligne complète
        }

        if (_quote is null && _localId is { } pending && _drafts?.SyncedServerId(pending) is { } sent)
        {
            Navigation.NavigateTo($"quotes/{sent}", new NavigationOptions { ReplaceHistoryEntry = true });
            return;   // déjà parti avec l'envoi des brouillons : pas de second devis
        }

        OperationResult<QuoteResponse> result = _quote is null
            ? await Quotes.CreateAsync(_request, CancellationToken.None)
            : await Quotes.UpdateAsync(_quote.Id, _request, _quote.Version, CancellationToken.None);
        if (_drafts is not null && OfflineDrafts.IsUnreachable(result) && await KeepOnDeviceAsync(_drafts))
        {
            return;
        }

        if (result.IsSuccess && _localId is { } local)
        {
            _localId = null;
            await _drafts!.ForgetAsync(local, CancellationToken.None);
        }

        await HandleSavedAsync(result);
    }

    /// <summary>Pas de réseau : la saisie reste sur l'appareil et partira à son retour (étape 4.5).</summary>
    private async Task<bool> KeepOnDeviceAsync(OfflineDrafts drafts)
    {
        bool created = _localId is null && _quote is null;
        if (await drafts.KeepQuoteAsync(_localId, _quote, _request, _customerName ?? _customerPicker?.DisplayedName, CancellationToken.None) is not { } kept)
        {
            return false;   // pas de stockage sur l'appareil (session ou dossier inconnu) : l'erreur s'affiche comme en ligne
        }

        _localId = kept;
        _errors = [];
        _status = L["Drafts.KeptOnDevice"];
        if (created)
        {
            _loadedId = _localId;
            Navigation.NavigateTo($"quotes/draft/{_localId}", new NavigationOptions { ReplaceHistoryEntry = true });
        }

        StateHasChanged();
        return true;
    }

    private async Task HandleSavedAsync(OperationResult<QuoteResponse> result)
    {
        if (result.Value is null)
        {
            _errors = result.Errors;
            _conflict = result.Errors.Any(e => e.Code == ErrorCodes.Concurrency.VersionMismatch);
            StateHasChanged();
            return;
        }

        bool created = _quote is null;
        _errors = [];
        Toasts.Show(ToastKind.Success, L[created ? "Billing.Toast.Created" : "Billing.Toast.Saved"].Value);
        _quote = result.Value;
        _customerName = result.Value.Customer.Name;
        // Totaux du serveur, sauf si une saisie attend ou qu'une ligne incomplète (non envoyée) compte à l'écran.
        if (!_autosave.IsDirty && !_lines.Any(l => l.IsIncomplete))
        {
            _totals = ToTotals(result.Value.Totals);
        }

        await CheckAsync();
        if (created)
        {
            _loadedId = result.Value.Id;
            Navigation.NavigateTo($"quotes/{result.Value.Id}", new NavigationOptions { ReplaceHistoryEntry = true });
        }

        StateHasChanged();
    }

    private async Task CheckAsync()
    {
        if (_quote is null || _quote.Status != QuoteStatusDto.Draft)
        {
            _compliance = null;
            return;
        }

        OperationResult<ComplianceReportResponse> report = await Quotes.CheckAsync(_quote.Id, CancellationToken.None);
        _compliance = report.Value;
    }

    private async Task ReloadAsync()
    {
        _loadedId = null;
        await OnParametersSetAsync();
    }

    // ---------- actions ----------

    private async Task ValidateAsync()
    {
        await _autosave.FlushAsync();
        if (!CanValidate || _quote is null)
        {
            return;
        }

        await RunAsync(() => Quotes.ValidateAsync(_quote.Id, _quote.Version, CancellationToken.None), "Quote.Validated");
    }

    private Task SetOutcomeAsync(bool accepted) =>
        _quote is null ? Task.CompletedTask
            : RunAsync(() => Quotes.SetOutcomeAsync(_quote.Id, accepted, _quote.Version, CancellationToken.None), accepted ? "Quote.AcceptedDone" : "Quote.RefusedDone");

    private async Task RunAsync(Func<Task<OperationResult<QuoteResponse>>> action, string successKey)
    {
        _busy = true;
        _status = null;
        try
        {
            OperationResult<QuoteResponse> result = await action();
            if (result.Value is null)
            {
                _errors = result.Errors;
                _conflict = result.Errors.Any(e => e.Code == ErrorCodes.Concurrency.VersionMismatch);
                return;
            }

            _errors = [];
            Show(result.Value, replaceLines: true);
            _compliance = null;
            _status = string.Format(CultureInfo.CurrentCulture, L[successKey], result.Value.Number);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateInvoiceAsync()
    {
        if (_quote is null)
        {
            return;
        }

        OperationResult<InvoiceResponse> invoice = await Quotes.CreateInvoiceAsync(_quote.Id, CancellationToken.None);
        if (invoice.Value is null)
        {
            _errors = invoice.Errors;
            return;
        }

        Toasts.Show(ToastKind.Success, string.Format(CultureInfo.CurrentCulture, L["Quote.Toast.InvoiceCreated"], _quote.Number));
        Navigation.NavigateTo($"invoices/{invoice.Value.Id}");
    }

    private async Task CreateDownPaymentAsync()
    {
        if (_quote is null)
        {
            return;
        }

        OperationResult<InvoiceResponse> invoice = await Quotes.CreateDownPaymentAsync(_quote.Id,
            new CreateDownPaymentRequest { Percent = _downPaymentPercent }, CancellationToken.None);
        if (invoice.Value is null)
        {
            _errors = invoice.Errors;
            return;
        }

        Toasts.Show(ToastKind.Success, string.Format(CultureInfo.CurrentCulture, L["Quote.Toast.DownPaymentCreated"], _quote.Number));
        Navigation.NavigateTo($"invoices/{invoice.Value.Id}");
    }

    private async Task DeleteAsync()
    {
        if (_quote is null)
        {
            return;
        }

        _autosave.Discard();
        OperationResult<bool> deleted = await Quotes.DeleteAsync(_quote.Id, _quote.Version, CancellationToken.None);
        if (!deleted.IsSuccess)
        {
            _errors = deleted.Errors;
            return;
        }

        Toasts.Show(ToastKind.Success, L["Billing.Toast.Deleted"].Value);
        Navigation.NavigateTo("quotes");
    }

    private async Task DownloadPdfAsync()
    {
        await _autosave.FlushAsync();
        if (_quote is null)
        {
            return;
        }

        CultureInfo culture = CultureInfo.GetCultureInfo(_pdfCulture);
        byte[] pdf = Pdf.Render(PrintableMapper.FromQuote(_quote, _company, culture));
        string name = _quote.Number ?? L["Quote.FileDraft"];
        await Files.DownloadAsync($"{name}.pdf", "application/pdf", pdf, CancellationToken.None);
    }

    // ---------- checklist → champ fautif ----------

    private async Task FocusFindingAsync(ComplianceFindingResponse finding)
    {
        switch (finding.Code)
        {
            case var code when code.StartsWith("Mention.Customer", StringComparison.Ordinal):
                await ExpandAsync(_mainBlock);
                if (_customerPicker is not null)
                {
                    await _customerPicker.FocusAsync();
                }

                break;
            case var code when code.StartsWith("Mention.Seller", StringComparison.Ordinal)
                || code is ErrorCodes.Mention.LatePenalties or ErrorCodes.Mention.RecoveryIndemnity
                    or ErrorCodes.Mention.EarlyPaymentDiscount or ErrorCodes.Mention.VatOnDebits:
                Navigation.NavigateTo("settings/company");
                break;
            case ErrorCodes.Mention.DueDate:
                await ExpandAsync(_mainBlock);
                await FocusAsync(_validUntil?.Element ?? default);
                break;
            default:
                await ExpandAsync(_linesBlock);
                if (_linesGrid is not null)
                {
                    await _linesGrid.FocusLineAsync((finding.Line ?? 1) - 1);
                }

                break;
        }
    }

    private static Task ExpandAsync(Collapsible? block) => block?.ExpandAsync() ?? Task.CompletedTask;

    private static async Task FocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Rendu sans navigateur (tests).
        }
    }

    public void Dispose()
    {
        _autosave.Dispose();
        if (_drafts is not null)
        {
            _drafts.Synced -= DraftSynced;
        }
    }
}
