@page "/invoices/new"
@page "/invoices/{Id:guid}"
@page "/invoices/draft/{LocalId:guid}"
@using Lettra.Contracts.Serialization
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IInvoicesGateway Invoices
@inject IBillingSettingsGateway Settings
@inject IServiceProvider Services
@inject IDocumentPdfRenderer Pdf
@inject IFileDownloader Files
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<SharedResource> L
@* Facture, facture d'acompte et avoir : même écran. Les lignes d'un acompte, d'un avoir ou d'une facture finale
   viennent d'une autre pièce et ne se saisissent pas ; l'en-tête (dates, conditions) reste modifiable en brouillon. *@

<PageTitle>@Title · Lettra</PageTitle>

<h1 tabindex="-1">@Title <DocumentStatusBadge Text="@StatusText" Kind="@StatusKind" /></h1>

<GlobalShortcuts Scope="_pageScope" />

@if (_conflict)
{
    <div class="lettra-banner is-warning" role="alert">
        @L["Billing.Conflict"]
        <button type="button" class="lettra-button" @onclick="ReloadAsync">@L["Billing.Reload"]</button>
    </div>
}

<GeneralErrors Errors="_errors" />
<StatusToast Message="@_status" />

@if (_loading)
{
    <p>@L["Loading"]</p>
}
else
{
    <div class="lettra-document">
        <div class="lettra-document-main">
            <Collapsible @ref="_mainBlock" Id="invoice-main" Title="@L["Billing.Section.Main"]" Summary="@MainSummary">
                <div class="lettra-document-header" role="group" aria-label="@L["Billing.Header"]">
                    <CustomerPicker @ref="_customerPicker" CustomerId="_request.CustomerId" SelectedName="@_customerName"
                                    ReadOnly="@(IsReadOnly || LinesLocked)" OnSelected="CustomerSelectedAsync" />

                    @if (_invoice?.QuoteNumber is { } quoteNumber)
                    {
                        <p class="lettra-field lettra-muted">@string.Format(CultureInfo.CurrentCulture, L["Invoice.FromQuote"], quoteNumber)</p>
                    }
                    @if (_invoice?.CreditedInvoiceNumber is { } credited)
                    {
                        <p class="lettra-field lettra-muted">@string.Format(CultureInfo.CurrentCulture, L["Invoice.CreditOf"], credited)</p>
                    }
                    @if (_invoice is { BillingPeriodStart: { } periodStart, BillingPeriodEnd: { } periodEnd })
                    {
                        <p class="lettra-field lettra-muted" id="billing-period">@string.Format(CultureInfo.CurrentCulture, L["Invoice.BillingPeriod"], periodStart.ToString("d", CultureInfo.CurrentCulture), periodEnd.ToString("d", CultureInfo.CurrentCulture))</p>
                    }
                    @if (_invoice?.CreditApprovedAt is { } approvedAt)
                    {
                        <p class="lettra-field lettra-muted" id="credit-approved">@string.Format(CultureInfo.CurrentCulture, L["Invoice.CreditApproved"], approvedAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture))</p>
                    }

                    <div class="lettra-field">
                        <label for="due-date">@L["Invoice.Field.DueDate"]</label>
                        <input id="due-date" type="date" @ref="_dueDate" disabled="@IsReadOnly"
                               value="@Iso(_request.DueDate)" @onchange="e => DateChangedAsync(e, d => _request.DueDate = d)" />
                    </div>

                    <div class="lettra-field">
                        <label for="vat-regime">@L["Billing.Field.VatRegime"]</label>
                        <select id="vat-regime" disabled="@(IsReadOnly || LinesLocked)" value="@_request.VatRegime" @onchange="RegimeChangedAsync">
                            @foreach (VatRegimeOption regime in _reference.VatRegimes)
                            {
                                <option value="@regime.Regime">@L[$"VatRegime.{regime.Regime}"]</option>
                            }
                        </select>
                    </div>

                    <div class="lettra-field lettra-field-wide">
                        <label for="subject">@L["Billing.Field.Subject"]</label>
                        <SmartInput Id="subject" Voice="@(!IsReadOnly)" VoiceLabel="@L["Billing.Field.Subject"]" disabled="@IsReadOnly" Value="@_request.Subject" maxlength="200"
                                    OnCommitted="v => TextCommittedAsync(v, t => _request.Subject = t)" Templates="TextFieldKind.Subject" Spellcheck="true" Tidy="true" />
                    </div>
                </div>
            </Collapsible>

            <Collapsible @ref="_deliveryBlock" Id="invoice-delivery" Title="@L["Invoice.Section.Delivery"]" Summary="@DeliverySummary"
                         InitiallyOpen="@(_request.DeliveryDate is null)">
                <div class="lettra-document-header">
                    <div class="lettra-field">
                        <label for="delivery-date">@L["Invoice.Field.DeliveryDate"]</label>
                        <input id="delivery-date" type="date" @ref="_deliveryDate" disabled="@IsReadOnly"
                               value="@Iso(_request.DeliveryDate)" @onchange="e => DateChangedAsync(e, d => _request.DeliveryDate = d)" />
                    </div>

                    <div class="lettra-field lettra-field-wide">
                        <label for="payment-terms">@L["Invoice.Field.PaymentTerms"]</label>
                        <SmartInput Id="payment-terms" Voice="@(!IsReadOnly)" VoiceLabel="@L["Invoice.Field.PaymentTerms"]" disabled="@IsReadOnly" Value="@_request.PaymentTerms" maxlength="500" placeholder="@_company?.PaymentTerms"
                                    OnCommitted="v => TextCommittedAsync(v, t => _request.PaymentTerms = t)" Templates="TextFieldKind.PaymentTerms"
                                    Spellcheck="true" Tidy="true" data-tour="payment-terms" />
                    </div>

                    <div class="lettra-field lettra-field-wide">
                        <label for="delivery-address">@L["Invoice.Field.DeliveryAddress"]</label>
                        <textarea id="delivery-address" @ref="_deliveryAddress" rows="2" disabled="@IsReadOnly" maxlength="500"
                                  value="@_request.DeliveryAddress" @onchange="e => TextChangedAsync(e, v => _request.DeliveryAddress = v)"></textarea>
                    </div>
                </div>
            </Collapsible>

            <Collapsible @ref="_linesBlock" Id="invoice-lines" HeadingId="lines-title" Title="@L["Lines.Title"]" Summary="@LinesSummary">
                @if (LinesLocked && IsDraft)
                {
                    <p class="lettra-muted">@L["Error.Invoice.DerivedDocumentLocked"]</p>
                }
                <DocumentLinesGrid @ref="_linesGrid" Lines="_lines" ReferenceData="_reference" Regime="_request.VatRegime"
                                   ReadOnly="@(IsReadOnly || LinesLocked)" ResolvePrice="ResolvePriceAsync"
                                   OnLinesChanged="ScheduleSaveAsync" OnTotalsChanged="TotalsChanged" />
                <CustomerHabits CustomerId="_request.CustomerId" Enabled="@(!IsReadOnly && !LinesLocked)" Present="PresentItems"
                                OnAddItem="id => _linesGrid?.AddCatalogItemAsync(id) ?? Task.CompletedTask"
                                OfferTerms="string.IsNullOrWhiteSpace(_request.PaymentTerms)"
                                OnReuseTerms="t => TextCommittedAsync(t, v => _request.PaymentTerms = v)" />
            </Collapsible>

            <Collapsible Id="invoice-notes" Title="@L["Billing.Field.Notes"]" Summary="@NotesSummary" InitiallyOpen="@(!string.IsNullOrEmpty(_request.Notes))"
                         Class="lettra-notes">
                <div class="lettra-field">
                    <label for="notes" class="lettra-visually-hidden">@L["Billing.Field.Notes"]</label>
                    <SmartInput Id="notes" Voice="@(!IsReadOnly)" VoiceLabel="@L["Billing.Field.Notes"]" Multiline="true" Rows="3" disabled="@IsReadOnly" Value="@_request.Notes" maxlength="4000"
                                OnCommitted="v => TextCommittedAsync(v, t => _request.Notes = t)" Templates="TextFieldKind.InvoiceNotes" Spellcheck="true" Tidy="true" />
                </div>
            </Collapsible>
        </div>

        <aside class="lettra-document-side">
            <DocumentTotalsPanel Totals="_totals" />

            <div class="lettra-actions">
                @if (IsDraft)
                {
                    <button type="button" id="validate" class="lettra-button" disabled="@(!CanValidate)" @onclick="ValidateAsync"
                            title="@L["Billing.Command.Validate"] (Ctrl+Enter)">@L["Billing.Command.Validate"]</button>
                    <button type="button" id="save" class="lettra-button is-secondary" disabled="@_busy" @onclick="SaveNowAsync">@L["Billing.Command.Save"]</button>
                    @if (AwaitsApproval)
                    {
                        <button type="button" id="approve-credit" class="lettra-button" disabled="@_busy" @onclick="ApproveCreditAsync">@L["Invoice.Command.ApproveCredit"]</button>
                    }
                }
                @if (_invoice?.Status == InvoiceStatusDto.Validated)
                {
                    <button type="button" id="issue" class="lettra-button" @onclick="IssueAsync">@L["Invoice.Command.Issue"]</button>
                }
                @if (_invoice is { Status: not InvoiceStatusDto.Draft, Kind: not InvoiceKindDto.CreditNote })
                {
                    <div class="lettra-inline">
                        <label for="credit-reason">@L["Invoice.Field.CreditReason"]</label>
                        <input id="credit-reason" @bind="_creditReason" maxlength="500" />
                        <button type="button" id="credit-note" class="lettra-button is-secondary" @onclick="CreateCreditNoteAsync">@L["Invoice.Command.CreditNote"]</button>
                    </div>
                }
                <div class="lettra-inline">
                    <label for="pdf-language">@L["Billing.Field.PdfLanguage"]</label>
                    <select id="pdf-language" @bind="_pdfCulture">
                        <option value="fr-FR">Français</option>
                        <option value="en-US">English</option>
                    </select>
                    <button type="button" id="pdf" class="lettra-button is-secondary" disabled="@(_invoice is null)" @onclick="DownloadPdfAsync"
                            title="@L["Billing.Command.Pdf"] (Ctrl+P)">@L["Billing.Command.Pdf"]</button>
                </div>
                @if (_invoice is { Status: not InvoiceStatusDto.Draft, Number: not null })
                {
                    <div class="lettra-inline">
                        <button type="button" id="facturx" class="lettra-button is-secondary" disabled="@_busy" @onclick="DownloadFacturXAsync">@L["Invoice.Command.FacturX"]</button>
                        <button type="button" id="ubl" class="lettra-button is-secondary" disabled="@_busy" @onclick="DownloadUblAsync">@L["Invoice.Command.Ubl"]</button>
                    </div>
                }
                @if (IsDraft && _invoice is not null)
                {
                    <button type="button" class="lettra-link is-danger" @onclick="DeleteAsync">@L["Billing.Command.Delete"]</button>
                }
            </div>

            <ComplianceChecklist Report="_compliance" OnFindingSelected="FocusFindingAsync" DocumentId="Id" />

            @if (_invoice is { Status: not InvoiceStatusDto.Draft, Number: not null } transmitted)
            {
                <PlatformTransmissionPanel Invoice="transmitted" OnInvoiceChanged="ReloadAsync" />
            }
        </aside>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Brouillon gardé sur l'appareil faute de réseau, pas encore arrivé sur le serveur (étape 4.5).</summary>
    [Parameter] public Guid? LocalId { get; set; }

    [SupplyParameterFromQuery(Name = "customer")] public Guid? CustomerFromQuery { get; set; }

    /// <summary><c>credit-note</c> : la palette (« avoir sur F-… ») prépare l'avoir dès l'ouverture.</summary>
    [SupplyParameterFromQuery(Name = "action")] public string? Action { get; set; }

    /// <summary>Pause de saisie avant l'enregistrement du brouillon ; 0 dans les tests.</summary>
    [Parameter] public TimeSpan AutosaveDelay { get; set; } = TimeSpan.FromMilliseconds(800);

    private SaveInvoiceRequest _request = new();
    private InvoiceResponse? _invoice;
    private List<DocumentLineRow> _lines = [];
    private BillingReferenceData _reference = new([], [], []);
    private DocumentTotals _totals = new([], 0m, 0m, 0m);
    private ComplianceReportResponse? _compliance;
    private CompanyProfileResponse? _company;
    private IReadOnlyList<ErrorDetail> _errors = [];
    private bool _approvalRequested;
    private string? _status;
    private string? _customerName;
    private string? _creditReason;
    private bool _loading = true;
    private bool _conflict;
    private bool _busy;
    private string _pdfCulture = "fr-FR";
    private DraftAutosave _autosave = default!;
    private KeyboardScope _pageScope = default!;
    private CustomerPicker? _customerPicker;
    private DocumentLinesGrid? _linesGrid;
    private Collapsible? _mainBlock;
    private Collapsible? _deliveryBlock;
    private Collapsible? _linesBlock;
    private ElementReference _deliveryDate;
    private ElementReference _dueDate;
    private ElementReference _deliveryAddress;
    private Guid? _loadedId;
    private OfflineDrafts? _drafts;
    private Guid? _localId;

    private bool IsDraft => _invoice is null || _invoice.Status == InvoiceStatusDto.Draft;

    private bool IsReadOnly => !IsDraft || _busy;

    /// <summary>Lignes venues d'une autre pièce (acompte, avoir, facture finale d'un devis).</summary>
    private bool LinesLocked => _invoice is not null && (_invoice.Kind != InvoiceKindDto.Invoice || _invoice.QuoteId is not null);

    // Avoir au-delà du seuil de la séparation des tâches : le serveur l'a signalé à la validation, un manager l'approuve ici.
    private bool AwaitsApproval => _approvalRequested && _invoice is { Kind: InvoiceKindDto.CreditNote, CreditApprovedBy: null };

    private bool CanValidate => _invoice is not null && !_busy && !_conflict && _compliance is { BlocksValidation: false };

    private InvoiceKindDto Kind => _invoice?.Kind ?? InvoiceKindDto.Invoice;

    private string Title => _invoice?.Number is { } number
        ? string.Format(CultureInfo.CurrentCulture, L[$"InvoiceKind.{Kind}.TitleNumber"], number)
        : L[_invoice is null ? "InvoiceKind.Invoice.TitleNew" : $"InvoiceKind.{Kind}.TitleDraft"];

    /// <summary>Résumés des blocs repliés.</summary>
    private string MainSummary => BillingSummaries.Join(
        _customerName ?? L["Billing.Summary.NoCustomer"].Value,
        _request.DueDate is { } due ? string.Format(CultureInfo.CurrentCulture, L["Invoice.Summary.Due"], due.ToString("d", CultureInfo.CurrentCulture)) : null,
        L[$"VatRegime.{_request.VatRegime}"].Value);

    private string DeliverySummary => BillingSummaries.Join(
        _request.DeliveryDate is { } delivered
            ? string.Format(CultureInfo.CurrentCulture, L["Invoice.Summary.Delivered"], delivered.ToString("d", CultureInfo.CurrentCulture))
            : L["Invoice.Summary.NoDelivery"].Value,
        BillingSummaries.Excerpt(_request.PaymentTerms ?? _company?.PaymentTerms),
        string.IsNullOrWhiteSpace(_request.DeliveryAddress) ? null : L["Invoice.Summary.Address"].Value);

    private string LinesSummary => BillingSummaries.Lines(L, _lines.Count, _totals.TotalExclTax);

    private string NotesSummary => BillingSummaries.Excerpt(_request.Notes) ?? L["Billing.Summary.NoNotes"].Value;

    private string StatusText => L[$"InvoiceStatus.{_invoice?.Status ?? InvoiceStatusDto.Draft}"];

    private string StatusKind => (_invoice?.Status ?? InvoiceStatusDto.Draft).ToString().ToLowerInvariant();

    private static string? Iso(DateOnly? date) => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        _autosave = new DraftAutosave(SaveAsync, AutosaveDelay);
        _pageScope = new KeyboardScope("page")
            .Bind("Ctrl+S", L["Billing.Command.Save"], _ => SaveNowAsync(), _ => IsDraft)
            .Bind("Ctrl+Enter", L["Billing.Command.Validate"], _ => ValidateAsync(), _ => CanValidate)
            .Bind("Ctrl+P", L["Billing.Command.Pdf"], _ => DownloadPdfAsync(), _ => _invoice is not null);
        _drafts = Services.GetService<OfflineDrafts>();
        if (_drafts is not null)
        {
            _drafts.Synced += DraftSynced;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == (Id ?? LocalId) && !_loading)
        {
            return;
        }

        _loadedId = Id ?? LocalId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errors = [];
        _approvalRequested = false;
        _conflict = false;
        _autosave.Discard();
        _localId = null;
        _status = null;

        OperationResult<BillingReferenceData> reference = await Settings.GetReferenceDataAsync(CancellationToken.None);
        _reference = (_drafts is null ? reference.Value
            : await _drafts.CachedAsync(OfflineDrafts.ReferenceDataKey, reference, ContractsJsonContext.Default.BillingReferenceData, CancellationToken.None))
            ?? _reference;
        OperationResult<CompanyProfileResponse> company = await Settings.GetCompanyProfileAsync(CancellationToken.None);
        _company = _drafts is null ? company.Value
            : await _drafts.CachedAsync(OfflineDrafts.CompanyProfileKey, company, ContractsJsonContext.Default.CompanyProfileResponse, CancellationToken.None);

        if (Id is { } id)
        {
            OperationResult<InvoiceResponse> loaded = await Invoices.GetAsync(id, CancellationToken.None);
            if (loaded.Value is null)
            {
                _errors = loaded.Errors;
                _loading = false;
                return;
            }

            Show(loaded.Value);
            await RestoreAsync(serverId: id, localId: null);
            await CheckAsync();
            if (Action == "credit-note")
            {
                _status = L["Invoice.CreditNoteHint"];
            }
        }
        else if (LocalId is { } localId)
        {
            if (_drafts?.SyncedServerId(localId) is { } sent)
            {
                Navigation.NavigateTo($"invoices/{sent}", new NavigationOptions { ReplaceHistoryEntry = true });
                return;
            }

            _invoice = null;
            _compliance = null;
            if (!await RestoreAsync(serverId: null, localId))
            {
                _status = L["Drafts.NotFound"];
            }
        }
        else
        {
            _invoice = null;
            _request = new SaveInvoiceRequest { VatRegime = _company?.VatFranchise == true ? VatRegimeDto.Franchise : VatRegimeDto.Standard };
            _lines = [];
            _compliance = null;
            _customerName = null;
            if (CustomerFromQuery is { } customerId)
            {
                _request.CustomerId = customerId;
            }
        }

        await PreselectPdfLanguageAsync();
        _loading = false;
    }

    /// <summary>
    /// Reprend la saisie gardée sur l'appareil : pour une pièce du serveur, seulement si elle s'appuie sur sa version
    /// actuelle (sinon l'envoi signalera le conflit) ; le prochain enregistrement en ligne la retire de l'appareil.
    /// </summary>
    private async Task<bool> RestoreAsync(Guid? serverId, Guid? localId)
    {
        if (_drafts is null
            || await _drafts.FindAsync(OfflineDraftKind.Invoice, serverId, localId, CancellationToken.None) is not { } draft
            || (_invoice is not null && draft.BaseVersion != _invoice.Version)
            || OfflineDrafts.InvoiceRequestOf(draft) is not { } request)
        {
            return false;
        }

        _localId = draft.LocalId;
        _request = request;
        _customerName = draft.Title ?? _customerName;
        _lines = [.. request.Lines.Select(l => DocumentLineRow.From(l,
            _reference.VatRates.FirstOrDefault(r => r.Code == l.VatRateCode)?.Percent ?? 0m))];
        _status = L["Drafts.Restored"];
        return true;
    }

    private void DraftSynced(object? sender, OfflineDraftSynced synced)
    {
        if (synced.Kind != OfflineDraftKind.Invoice || synced.LocalId != _localId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _localId = null;
            if (_invoice?.Id == synced.ServerId)
            {
                await ReloadAsync();
                StateHasChanged();
            }
            else
            {
                Navigation.NavigateTo($"invoices/{synced.ServerId}", new NavigationOptions { ReplaceHistoryEntry = true });
            }
        });
    }

    private void Show(InvoiceResponse invoice)
    {
        _invoice = invoice;
        _customerName = invoice.Customer.Name;
        _request = new SaveInvoiceRequest
        {
            CustomerId = invoice.CustomerId,
            DeliveryDate = invoice.DeliveryDate,
            DueDate = invoice.DueDate,
            PaymentTerms = invoice.PaymentTerms,
            DeliveryAddress = invoice.DeliveryAddress,
            VatRegime = invoice.VatRegime,
            Subject = invoice.Subject,
            Notes = invoice.Notes,
        };
        _lines = [.. invoice.Lines.OrderBy(l => l.Position).Select(DocumentLineRow.From)];
        _totals = QuoteEditor.ToTotals(invoice.Totals);
    }

    // ---------- saisie de l'en-tête ----------

    private async Task CustomerSelectedAsync(CustomerSummary customer)
    {
        _request.CustomerId = customer.Id;
        _customerName = customer.Name;
        await PreselectPdfLanguageAsync();
        await ScheduleSaveAsync();
    }

    /// <summary>Langue du PDF proposée : celle du client, le français sinon (elle reste modifiable).</summary>
    private async Task PreselectPdfLanguageAsync()
    {
        if (_request.CustomerId == Guid.Empty || Services.GetService(typeof(ICustomersGateway)) is not ICustomersGateway customers)
        {
            return;
        }

        OperationResult<CustomerResponse> customer = await customers.GetAsync(_request.CustomerId, CancellationToken.None);
        _pdfCulture = customer.Value?.PreferredLanguage ?? "fr-FR";
    }

    private async Task DateChangedAsync(ChangeEventArgs e, Action<DateOnly?> set)
    {
        set(DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out DateOnly date) ? date : null);
        await ScheduleSaveAsync();
    }

    private async Task TextChangedAsync(ChangeEventArgs e, Action<string?> set) => await TextCommittedAsync(e.Value?.ToString(), set);

    private async Task TextCommittedAsync(string? text, Action<string?> set)
    {
        set(string.IsNullOrWhiteSpace(text) ? null : text.Trim());
        await ScheduleSaveAsync();
    }

    /// <summary>Articles déjà sur la facture : les suggestions du client ne les reproposent pas.</summary>
    private Guid[] PresentItems => [.. _lines.Where(l => l.CatalogItemId is not null).Select(l => l.CatalogItemId!.Value)];

    private async Task RegimeChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out VatRegimeDto regime))
        {
            _request.VatRegime = regime;
            await ScheduleSaveAsync();
        }
    }

    private void TotalsChanged(DocumentTotals totals) => _totals = totals;

    private async Task<ResolvedPrice?> ResolvePriceAsync(Guid catalogItemId)
    {
        if (_request.CustomerId == Guid.Empty || Services.GetService(typeof(IPriceListsGateway)) is not IPriceListsGateway prices)
        {
            return null;
        }

        OperationResult<IReadOnlyList<ResolvedPrice>> result = await prices.ResolveAsync(_request.CustomerId, [catalogItemId], CancellationToken.None);
        return result.Value?.FirstOrDefault();
    }

    // ---------- enregistrement du brouillon et checklist ----------

    private Task ScheduleSaveAsync() => IsDraft && !_conflict ? _autosave.ScheduleAsync() : Task.CompletedTask;

    /// <summary>
    /// Enregistrement demandé (bouton, Ctrl+S) : la pièce ne naît qu'avec son client et une ligne complète ; s'il en
    /// manque un, on le dit et on y place le curseur au lieu de laisser un bouton inactif sans explication.
    /// </summary>
    private async Task SaveNowAsync()
    {
        if (_invoice is null && _request.CustomerId == Guid.Empty)
        {
            _errors = [new ErrorDetail(ErrorCodes.Billing.CustomerRequired)];
            await ExpandAsync(_mainBlock);
            if (_customerPicker is not null)
            {
                await _customerPicker.FocusAsync();
            }

            return;
        }

        if (_invoice is null && _lines.All(l => l.IsIncomplete))
        {
            _errors = [new ErrorDetail(ErrorCodes.Billing.LinesRequired)];
            return;
        }

        await ScheduleSaveAsync();
        await _autosave.FlushAsync();
    }

    private async Task SaveAsync()
    {
        if (_request.CustomerId == Guid.Empty)
        {
            return;   // un brouillon naît avec son client
        }

        _request.Lines = [.. _lines.Where(l => !l.IsIncomplete).Select(l => l.ToRequest())];
        if (_invoice is null && _request.Lines.Count == 0)
        {
            return;   // pas de pièce vide : elle naît avec sa première ligne complète
        }

        if (_invoice is null && _localId is { } pending && _drafts?.SyncedServerId(pending) is { } sent)
        {
            Navigation.NavigateTo($"invoices/{sent}", new NavigationOptions { ReplaceHistoryEntry = true });
            return;   // déjà partie avec l'envoi des brouillons : pas de seconde facture
        }

        OperationResult<InvoiceResponse> result = _invoice is null
            ? await Invoices.CreateAsync(_request, CancellationToken.None)
            : await Invoices.UpdateAsync(_invoice.Id, _request, _invoice.Version, CancellationToken.None);
        if (_drafts is not null && OfflineDrafts.IsUnreachable(result) && await KeepOnDeviceAsync(_drafts))
        {
            return;
        }

        if (result.IsSuccess && _localId is { } local)
        {
            _localId = null;
            await _drafts!.ForgetAsync(local, CancellationToken.None);
        }

        if (result.Value is null)
        {
            _errors = result.Errors;
            _conflict = result.Errors.Any(e => e.Code == ErrorCodes.Concurrency.VersionMismatch);
            StateHasChanged();
            return;
        }

        bool created = _invoice is null;
        _errors = [];
        Toasts.Show(ToastKind.Success, L[created ? "Billing.Toast.Created" : "Billing.Toast.Saved"].Value);
        _invoice = result.Value;
        _customerName = result.Value.Customer.Name;
        // Totaux du serveur, sauf si une saisie attend ou qu'une ligne incomplète (non envoyée) compte à l'écran.
        if (!_autosave.IsDirty && !_lines.Any(l => l.IsIncomplete))
        {
            _totals = QuoteEditor.ToTotals(result.Value.Totals);
        }

        await CheckAsync();
        if (created)
        {
            _loadedId = result.Value.Id;
            Navigation.NavigateTo($"invoices/{result.Value.Id}", new NavigationOptions { ReplaceHistoryEntry = true });
        }

        StateHasChanged();
    }

    /// <summary>Pas de réseau : la saisie reste sur l'appareil et partira à son retour (étape 4.5).</summary>
    private async Task<bool> KeepOnDeviceAsync(OfflineDrafts drafts)
    {
        bool created = _localId is null && _invoice is null;
        if (await drafts.KeepInvoiceAsync(_localId, _invoice, _request, _customerName ?? _customerPicker?.DisplayedName, CancellationToken.None) is not { } kept)
        {
            return false;   // pas de stockage sur l'appareil (session ou dossier inconnu) : l'erreur s'affiche comme en ligne
        }

        _localId = kept;
        _errors = [];
        _status = L["Drafts.KeptOnDevice"];
        if (created)
        {
            _loadedId = _localId;
            Navigation.NavigateTo($"invoices/draft/{_localId}", new NavigationOptions { ReplaceHistoryEntry = true });
        }

        StateHasChanged();
        return true;
    }

    private async Task CheckAsync()
    {
        if (_invoice is null || _invoice.Status != InvoiceStatusDto.Draft)
        {
            _compliance = null;
            return;
        }

        OperationResult<ComplianceReportResponse> report = await Invoices.CheckAsync(_invoice.Id, CancellationToken.None);
        _compliance = report.Value;
    }

    private async Task ReloadAsync()
    {
        _loadedId = null;
        await OnParametersSetAsync();
    }

    // ---------- actions ----------

    private async Task ValidateAsync()
    {
        await _autosave.FlushAsync();
        if (!CanValidate || _invoice is null)
        {
            return;
        }

        await RunAsync(() => Invoices.ValidateAsync(_invoice.Id, _invoice.Version, CancellationToken.None), "Invoice.Validated");
    }

    private Task IssueAsync() =>
        _invoice is null ? Task.CompletedTask
            : RunAsync(() => Invoices.IssueAsync(_invoice.Id, _invoice.Version, CancellationToken.None), "Invoice.IssuedDone");

    private async Task RunAsync(Func<Task<OperationResult<InvoiceResponse>>> action, string successKey)
    {
        _busy = true;
        _status = null;
        try
        {
            OperationResult<InvoiceResponse> result = await action();
            if (result.Value is null)
            {
                _errors = result.Errors;
                _conflict = result.Errors.Any(e => e.Code == ErrorCodes.Concurrency.VersionMismatch);
                _approvalRequested |= result.Errors.Any(e => e.Code == ErrorCodes.SegregationOfDuties.ManagerApprovalRequired);
                return;
            }

            _errors = [];
            Show(result.Value);
            _compliance = null;
            _status = string.Format(CultureInfo.CurrentCulture, L[successKey], result.Value.Number);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveCreditAsync()
    {
        if (_invoice is null)
        {
            return;
        }

        await RunAsync(() => Invoices.ApproveCreditAsync(_invoice.Id, _invoice.Version, CancellationToken.None), "Invoice.CreditApprovedDone");
        // L'avoir reste un brouillon : sa checklist revient pour qu'il puisse être validé.
        await CheckAsync();
    }

    private async Task CreateCreditNoteAsync()
    {
        if (_invoice is null)
        {
            return;
        }

        OperationResult<InvoiceResponse> credit = await Invoices.CreateCreditNoteAsync(_invoice.Id,
            new CreateCreditNoteRequest { Reason = string.IsNullOrWhiteSpace(_creditReason) ? null : _creditReason.Trim() }, CancellationToken.None);
        if (credit.Value is null)
        {
            _errors = credit.Errors;
            return;
        }

        Toasts.Show(ToastKind.Success, string.Format(CultureInfo.CurrentCulture, L["Invoice.Toast.CreditNoteCreated"], _invoice.Number));
        Navigation.NavigateTo($"invoices/{credit.Value.Id}");
    }

    private async Task DeleteAsync()
    {
        if (_invoice is null)
        {
            return;
        }

        _autosave.Discard();
        OperationResult<bool> deleted = await Invoices.DeleteAsync(_invoice.Id, _invoice.Version, CancellationToken.None);
        if (!deleted.IsSuccess)
        {
            _errors = deleted.Errors;
            return;
        }

        Toasts.Show(ToastKind.Success, L["Billing.Toast.Deleted"].Value);
        Navigation.NavigateTo(Kind == InvoiceKindDto.CreditNote ? "credit-notes" : "invoices");
    }

    private async Task DownloadPdfAsync()
    {
        await _autosave.FlushAsync();
        if (_invoice is null)
        {
            return;
        }

        CultureInfo culture = CultureInfo.GetCultureInfo(_pdfCulture);
        byte[] pdf = Pdf.Render(PrintableMapper.FromInvoice(_invoice, _company, culture));
        string name = _invoice.Number ?? L[$"InvoiceKind.{Kind}.FileDraft"];
        await Files.DownloadAsync($"{name}.pdf", "application/pdf", pdf, CancellationToken.None);
    }

    // Facture électronique (phase 5) : le XML EN 16931 vient du serveur ou de la base locale ; le Factur-X est le PDF/A-3
    // de la pièce rendu ici, avec ce XML CII joint.
    private async Task DownloadFacturXAsync()
    {
        if (_invoice is not { Number: { } number } invoice || await EInvoiceAsync(invoice.Id, EInvoiceFormatDto.Cii) is not { } cii)
        {
            return;
        }

        CultureInfo culture = CultureInfo.GetCultureInfo(_pdfCulture);
        byte[] pdf = Pdf.Render(PrintableMapper.FromInvoice(invoice, _company, culture), [PdfAttachment.FacturX(cii)]);
        await Files.DownloadAsync($"{number}-factur-x.pdf", "application/pdf", pdf, CancellationToken.None);
    }

    private async Task DownloadUblAsync()
    {
        if (_invoice is { Number: { } number } invoice && await EInvoiceAsync(invoice.Id, EInvoiceFormatDto.Ubl) is { } ubl)
        {
            await Files.DownloadAsync($"{number}-ubl.xml", "application/xml", ubl, CancellationToken.None);
        }
    }

    private async Task<byte[]?> EInvoiceAsync(Guid id, EInvoiceFormatDto format)
    {
        _busy = true;
        try
        {
            OperationResult<byte[]> xml = await Invoices.GetEInvoiceAsync(id, format, CancellationToken.None);
            _errors = xml.Errors;
            return xml.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    // ---------- checklist → champ fautif ----------

    private async Task FocusFindingAsync(ComplianceFindingResponse finding)
    {
        switch (finding.Code)
        {
            case var code when code.StartsWith("Mention.Customer", StringComparison.Ordinal):
                await ExpandAsync(_mainBlock);
                if (_customerPicker is not null)
                {
                    await _customerPicker.FocusAsync();
                }

                break;
            case var code when code.StartsWith("Mention.Seller", StringComparison.Ordinal)
                || code is ErrorCodes.Mention.LatePenalties or ErrorCodes.Mention.RecoveryIndemnity
                    or ErrorCodes.Mention.EarlyPaymentDiscount or ErrorCodes.Mention.VatOnDebits:
                Navigation.NavigateTo("settings/company");
                break;
            case ErrorCodes.Mention.DeliveryDate:
                await ExpandAsync(_deliveryBlock);
                await FocusAsync(_deliveryDate);
                break;
            case ErrorCodes.Mention.DueDate:
                await ExpandAsync(_mainBlock);
                await FocusAsync(_dueDate);
                break;
            case ErrorCodes.Mention.DeliveryAddress:
                await ExpandAsync(_deliveryBlock);
                await FocusAsync(_deliveryAddress);
                break;
            default:
                await ExpandAsync(_linesBlock);
                if (_linesGrid is not null)
                {
                    await _linesGrid.FocusLineAsync((finding.Line ?? 1) - 1);
                }

                break;
        }
    }

    private static Task ExpandAsync(Collapsible? block) => block?.ExpandAsync() ?? Task.CompletedTask;

    private static async Task FocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Rendu sans navigateur (tests).
        }
    }

    public void Dispose()
    {
        _autosave.Dispose();
        if (_drafts is not null)
        {
            _drafts.Synced -= DraftSynced;
        }
    }
}
