@page "/quotes"
@inject IQuotesGateway Quotes
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Quotes.Title"] · Lettra</PageTitle>

<h1 tabindex="-1">@L["Quotes.Title"]</h1>

<GlobalShortcuts Scope="_pageScope" />

<section class="lettra-card" aria-labelledby="quotes-list-title">
    <h2 id="quotes-list-title" class="lettra-visually-hidden">@L["Quotes.List"]</h2>
    <div class="lettra-toolbar">
        <div class="lt-filter">
            <label for="quotes-search">@L["Billing.Search"]</label>
            <input id="quotes-search" type="search" @ref="_searchInput" @bind="_search" @bind:after="LoadAsync" autocomplete="off" />
        </div>
        <div class="lt-filter">
            <label for="quotes-status">@L["Billing.Status"]</label>
            <select id="quotes-status" @bind="_statusFilter" @bind:after="LoadAsync">
                <option value="">@L["Billing.AllStatuses"]</option>
                @foreach (QuoteStatusDto status in Enum.GetValues<QuoteStatusDto>())
                {
                    <option value="@status">@L[$"QuoteStatus.{status}"]</option>
                }
            </select>
        </div>
        <a class="lettra-button" href="quotes/new" id="quotes-new">@L["Quotes.New"]</a>
    </div>
    <p class="lettra-muted">@L["Billing.ListHint"]</p>

    <GeneralErrors Errors="_errors" />

    @if (_loading)
    {
        <ListSkeleton Columns="7" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Id="quotes-empty" IconName="file-text" Title="@(IsFiltered ? L["Lists.Empty.FilteredTitle"] : L["Quotes.Empty"])"
                    Text="@(IsFiltered ? L["Lists.Empty.Filtered"] : L["Quotes.Empty.Text"])">
            @if (!IsFiltered)
            {
                <a class="lettra-button" href="quotes/new"><Icon Name="plus" Size="18" /> @L["Quotes.New"]</a>
            }
        </EmptyState>
    }
    else
    {
        <table class="lettra-table lettra-documents lt-cards">
            <thead>
                <tr>
                    <th scope="col">@L["Billing.Column.Number"]</th>
                    <th scope="col">@L["Billing.Column.Customer"]</th>
                    <th scope="col">@L["Billing.Column.Date"]</th>
                    <th scope="col">@L["Quote.Field.ValidUntil"]</th>
                    <th scope="col">@L["Billing.Status"]</th>
                    <th scope="col" class="lg-num">@L["Totals.ExclTax"]</th>
                    <th scope="col" class="lg-num">@L["Totals.InclTax"]</th>
                    <th scope="col" class="lt-col-actions"><span class="lettra-visually-hidden">@L["Row.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (QuoteSummary quote in _items)
                {
                    <tr>
                        <td><a href="@($"quotes/{quote.Id}")">@(quote.Number ?? L["Billing.Draft"])</a></td>
                        <td data-label="@L["Billing.Column.Customer"]">@quote.CustomerName</td>
                        <td data-label="@L["Billing.Column.Date"]">@quote.IssueDate?.ToString("d", CultureInfo.CurrentCulture)</td>
                        <td data-label="@L["Quote.Field.ValidUntil"]">@quote.ValidUntil?.ToString("d", CultureInfo.CurrentCulture)</td>
                        <td data-label="@L["Billing.Status"]"><DocumentStatusBadge Text="@(quote.IsExpired ? L["Quote.Expired"] : L[$"QuoteStatus.{quote.Status}"])"
                                                 Kind="@(quote.IsExpired ? "expired" : quote.Status.ToString().ToLowerInvariant())" /></td>
                        <td class="lg-num" data-label="@L["Totals.ExclTax"]">@GridNumber.FormatAmount(quote.TotalExclTax, CultureInfo.CurrentCulture)</td>
                        <td class="lg-num" data-label="@L["Totals.InclTax"]">@GridNumber.FormatAmount(quote.TotalInclTax, CultureInfo.CurrentCulture)</td>
                        <td class="lt-col-actions">
                            <RowDelete Label="@string.Format(CultureInfo.CurrentCulture, L["Quotes.Row.Delete"], quote.Number ?? L["Billing.Draft"], quote.CustomerName)"
                                       BlockedReason="@(quote.Status == QuoteStatusDto.Draft ? null : L["Quotes.Row.Delete.Blocked"].Value)"
                                       OnDelete="() => DeleteAsync(quote)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private List<QuoteSummary> _items = [];
    private IReadOnlyList<ErrorDetail> _errors = [];
    private string? _search;
    private QuoteStatusDto? _statusFilter;
    private bool _loading = true;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _statusFilter is not null;
    private ElementReference _searchInput;
    private KeyboardScope _pageScope = default!;

    protected override void OnInitialized() =>
        _pageScope = new KeyboardScope("page")
            .Bind("F3", L["Billing.Command.Search"], async _ => await _searchInput.FocusAsync())
            .Bind("Insert", L["Quotes.New"], _ => Navigation.NavigateTo("quotes/new"));

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Un brouillon seulement : un devis numéroté reste (série DEV continue), il se refuse ou expire.</summary>
    private async Task DeleteAsync(QuoteSummary quote)
    {
        OperationResult<bool> deleted = await Quotes.DeleteAsync(quote.Id, null, CancellationToken.None);
        if (!deleted.IsSuccess)
        {
            _errors = deleted.Errors;
            return;
        }

        _items.Remove(quote);
        Toasts.Show(ToastKind.Success, L["Billing.Toast.Deleted"].Value);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        OperationResult<PagedResponse<QuoteSummary>> result = await Quotes.ListAsync(
            new BillingListQuery(string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), PageSize: 200), _statusFilter, CancellationToken.None);
        _items = result.Value?.Items.ToList() ?? [];
        _errors = result.Errors;
        _loading = false;
    }
}
