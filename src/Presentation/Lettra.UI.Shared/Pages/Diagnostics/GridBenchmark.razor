@page "/mesure-grille"
@using Lettra.UI.Shared.Diagnostics
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<DiagnosticsResource> D
@* Mesure de la grille sur le poste du cabinet (critère J1 de l'annexe C, en MAUI comme dans le navigateur) :
   une pièce de 1 000 lignes, une saisie rejouée au clavier à cadence humaine, et les p95 à copier dans le fil.
   La version de mesure de l'application MAUI s'ouvre directement ici (?auto=1 lance la mesure). *@

<PageTitle>@D["Bench.Title"] · Lettra</PageTitle>

<h1 tabindex="-1">@D["Bench.Title"]</h1>
<p>@string.Format(CultureInfo.CurrentCulture, D["Bench.Intro"], LineCount, CadenceMs)</p>

<div class="lettra-toolbar">
    <button type="button" id="bench-start" disabled="@_running" @onclick="RunAsync">@D["Bench.Start"]</button>
    @if (_report is not null)
    {
        <button type="button" id="bench-copy" @onclick="CopyAsync">@D["Bench.Copy"]</button>
    }
</div>

<div aria-live="polite">
    @if (_running)
    {
        <p role="status">@D["Bench.Running"]</p>
    }
    else if (_error is not null)
    {
        <p role="alert" class="validation-message">@string.Format(CultureInfo.CurrentCulture, D["Bench.Failed"], _error)</p>
    }
    else if (_report is not null)
    {
        <p role="status" class="lettra-success">@(_copied switch { true => D["Bench.Copied"], false => D["Bench.CopyFailed"], _ => D["Bench.Done"] })</p>
    }
</div>

@if (_report is { } report)
{
    <section class="lettra-card">
        <table class="lettra-table" id="bench-results">
            <thead>
                <tr>
                    <th scope="col">@D["Bench.Column.Measure"]</th>
                    <th scope="col">@D["Bench.Column.Count"]</th>
                    <th scope="col">@D["Bench.Column.Median"]</th>
                    <th scope="col">@D["Bench.Column.P95"]</th>
                    <th scope="col">@D["Bench.Column.Max"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach ((string label, LatencyStats stats) in report.Rows)
                {
                    <tr>
                        <th scope="row">@label</th>
                        <td class="lg-num">@stats.Count</td>
                        <td class="lg-num">@LatencyStats.Ms(stats.Median)</td>
                        <td class="lg-num"><strong>@LatencyStats.Ms(stats.P95)</strong></td>
                        <td class="lg-num">@LatencyStats.Ms(stats.Max)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p>@(report.Navigation.P95 < PerceptionThresholdMs ? D["Bench.Verdict.Ok"] : D["Bench.Verdict.Slow"])</p>
        @if (report.Missed > 0)
        {
            <p class="validation-message">@string.Format(CultureInfo.CurrentCulture, D["Bench.Missed"], report.Missed)</p>
        }
        <textarea id="bench-text" readonly rows="6" style="width: 100%; font-family: monospace;">@report.Text</textarea>
    </section>
}

<div @ref="_host" class="lettra-grid-host">
    <DataEntryGrid TItem="BenchLine" Items="_lines" Columns="_columns" KeySelector="l => l.Id" AriaLabel="@D["Bench.Grid"]" />
</div>

@code {
    public const int LineCount = 1000;
    public const int Keystrokes = 1000;
    public const int CadenceMs = 40;
    private const double PerceptionThresholdMs = 100;
    private const int QuantityColumn = 2;
    private const string ModulePath = "./_content/Lettra.UI.Shared/grid-benchmark.js";

    [SupplyParameterFromQuery(Name = "auto")] public int? Auto { get; set; }

    /// <summary>Hôte de la mesure, écrit dans le résultat (MAUI ou navigateur).</summary>
    public static string HostName =>
        OperatingSystem.IsBrowser() ? "WebAssembly" : OperatingSystem.IsWindows() ? "MAUI Windows" : OperatingSystem.IsMacCatalyst() ? "MAUI macOS" : ".NET " + Environment.OSVersion.Platform;

    private readonly List<BenchLine> _lines = [.. Enumerable.Range(1, LineCount).Select(BenchLine.Sample)];
    private IReadOnlyList<GridColumn<BenchLine>> _columns = [];
    private ElementReference _host;
    private IJSObjectReference? _module;
    private BenchReport? _report;
    private string? _error;
    private bool _running;
    private bool? _copied;

    protected override void OnInitialized()
    {
        CultureInfo culture = CultureInfo.CurrentCulture;
        _columns =
        [
            new() { Key = "reference", Label = D["Bench.Col.Reference"], Width = "7rem", Display = l => l.Reference, Parse = (l, t) => l with { Reference = t.Trim() } },
            new() { Key = "designation", Label = D["Bench.Col.Designation"], Width = "minmax(12rem, 3fr)", Wide = true, Display = l => l.Designation, Parse = (l, t) => l with { Designation = t.Trim() } },
            new() { Key = "quantity", Label = D["Bench.Col.Quantity"], Width = "5rem", Numeric = true, Display = l => l.Quantity.ToString("0.###", culture), Parse = (l, t) => l with { Quantity = ParseOr(t, l.Quantity) } },
            new() { Key = "price", Label = D["Bench.Col.Price"], Width = "7rem", Numeric = true, Display = l => GridNumber.FormatPrice(l.UnitPrice, culture), Parse = (l, t) => l with { UnitPrice = ParseOr(t, l.UnitPrice) } },
            new() { Key = "discount", Label = D["Bench.Col.Discount"], Width = "5rem", Numeric = true, Display = l => l.Discount.ToString("0.##", culture), Parse = (l, t) => l with { Discount = ParseOr(t, l.Discount) } },
            new() { Key = "vat", Label = D["Bench.Col.Vat"], Width = "5rem", Numeric = true, Display = l => l.VatRate.ToString("0.##", culture), Parse = (l, t) => l with { VatRate = ParseOr(t, l.VatRate) } },
            new() { Key = "total", Label = D["Bench.Col.Total"], Width = "7rem", Numeric = true, Display = l => GridNumber.FormatAmount(l.Total, culture) },
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Auto == 1)
        {
            await RunAsync();
        }
    }

    private static decimal ParseOr(string text, decimal fallback) =>
        GridNumber.TryParse(text, CultureInfo.CurrentCulture, out decimal value) ? value : fallback;

    private async Task RunAsync()
    {
        _running = true;
        _error = null;
        _report = null;
        _copied = null;
        StateHasChanged();
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            // Laisse la grille s'attacher à son module clavier avant la première frappe.
            await Task.Delay(300);
            GridBenchmarkRun run = await _module.InvokeAsync<GridBenchmarkRun>("run", TimeSpan.FromMinutes(5), _host,
                new { keystrokes = Keystrokes, cadenceMs = CadenceMs, editableColumns = 6, quantityColumn = QuantityColumn });
            GridBenchmarkEnvironment environment = await _module.InvokeAsync<GridBenchmarkEnvironment>("environment");
            _report = BenchReport.From(run, environment, D);
        }
        catch (JSException exception)
        {
            _error = exception.Message;
        }
        catch (TaskCanceledException)
        {
            _error = "timeout";
        }
        finally
        {
            _running = false;
            // Lancée par ?auto=1 depuis OnAfterRenderAsync, la mesure ne profite d'aucun rendu automatique.
            StateHasChanged();
        }
    }

    private async Task CopyAsync()
    {
        if (_module is not null && _report is not null)
        {
            _copied = await _module.InvokeAsync<bool>("copyText", _report.Text);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Hôte fermé.
            }
        }
    }

    /// <summary>Ligne de la pièce de mesure : montants réalistes, total recalculé à chaque saisie.</summary>
    public sealed record BenchLine(int Id, string Reference, string Designation, decimal Quantity, decimal UnitPrice, decimal Discount, decimal VatRate)
    {
        public decimal Total => Math.Round(Quantity * UnitPrice * (1 - (Discount / 100m)), 2, MidpointRounding.AwayFromZero);

        public static BenchLine Sample(int id) =>
            new(id, $"ART-{id:0000}", $"Prestation de conseil n° {id}", 1 + (id % 7), 50m + (id % 13 * 12.5m), id % 10 == 0 ? 5m : 0m, id % 4 == 0 ? 5.5m : 20m);
    }

    /// <summary>Lignes du tableau et texte à coller dans le fil.</summary>
    public sealed record BenchReport(LatencyStats Navigation, LatencyStats Entry, LatencyStats Amount, int Missed, string Text,
        IReadOnlyList<(string Label, LatencyStats Stats)> Rows)
    {
        public static BenchReport From(GridBenchmarkRun run, GridBenchmarkEnvironment environment, IStringLocalizer<DiagnosticsResource> d)
        {
            ArgumentNullException.ThrowIfNull(run);
            ArgumentNullException.ThrowIfNull(environment);
            ArgumentNullException.ThrowIfNull(d);
            LatencyStats navigation = LatencyStats.From(run.Navigation);
            LatencyStats entry = LatencyStats.From(run.Entry);
            LatencyStats amount = LatencyStats.From(run.Amount);
            string text = string.Join(Environment.NewLine,
                $"Lettra · mesure de la grille · {HostName} · {DateTime.Now.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}",
                $"{LineCount} lignes, {Keystrokes} frappes, une toutes les {CadenceMs} ms, {environment.Cores} cœurs, fenêtre {environment.Width}×{environment.Height} @{environment.PixelRatio.ToString("0.##", CultureInfo.InvariantCulture)}",
                $"Navigation p95 = {LatencyStats.Ms(navigation.P95)} (médiane {LatencyStats.Ms(navigation.Median)}, max {LatencyStats.Ms(navigation.Max)}, n = {navigation.Count})",
                $"Tab après saisie p95 = {LatencyStats.Ms(entry.P95)} (n = {entry.Count})",
                $"Mise à jour du montant p95 = {LatencyStats.Ms(amount.P95)} (n = {amount.Count})",
                $"Sans réponse : {run.Missed} · {environment.UserAgent}");
            return new BenchReport(navigation, entry, amount, run.Missed, text,
            [
                (d["Bench.Navigation"], navigation),
                (d["Bench.Entry"], entry),
                (d["Bench.Amount"], amount),
            ]);
        }
    }
}
