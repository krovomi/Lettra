@page "/alerts"
@page "/alerts/{Id:guid}"
@using Lettra.Contracts.Alerts
@inject IAlertsGateway Gateway
@inject ToastService Toasts
@inject IStringLocalizer<SharedResource> L

@* Centre d'alertes v1 (annexe G §8) : compteurs par gravité, liste triée, détail avec sa chronologie et actions
   tracées. Aucune donnée de dossier : titre de la règle, portée et dates. *@

<PageTitle>@L["Alerts.Title"] · Lettra</PageTitle>

<div class="lt-page-header">
    <div>
        <h1 tabindex="-1">@L["Alerts.Title"]</h1>
        <p>@L["Alerts.Subtitle"]</p>
    </div>
    <div class="lt-chips" role="group" aria-label="@L["Alerts.Filters"]">
        <label class="lt-chip"><input type="checkbox" id="alerts-cabinet" checked="@_cabinetWide" @onchange="ToggleCabinetAsync" /> @L["Alerts.CabinetWide"]</label>
        <label class="lt-chip"><input type="checkbox" id="alerts-closed" checked="@_includeClosed" @onchange="ToggleClosedAsync" /> @L["Alerts.IncludeClosed"]</label>
    </div>
</div>

<GeneralErrors Errors="_errors" />

@if (_centre is null)
{
    <div class="lt-kpis" aria-busy="true" aria-label="@L["Loading"]">
        @for (int i = 0; i < 4; i++)
        {
            <div class="lt-kpi"><span class="lt-skeleton" style="height: 1rem; width: 40%"></span><span class="lt-skeleton" style="height: 2rem; width: 30%"></span></div>
        }
    </div>
}
else
{
    <section aria-labelledby="counters-title">
        <h2 id="counters-title" class="lettra-visually-hidden">@L["Alerts.Counters.Title"]</h2>
        <ul class="lt-kpis lettra-alert-counters">
            @foreach (AlertSeverityCounter counter in _centre.Counters)
            {
                <li class="lt-kpi lt-severity-card lettra-severity-@counter.Severity.ToString().ToLowerInvariant() @(counter.Open > 0 ? "has-open" : null)">
                    <span class="lt-kpi-head">
                        <span class="lt-severity-badge" data-severity="@counter.Severity">@counter.Severity</span>
                        <span class="lt-kpi-icon"><Icon Name="@(counter.Open > 0 ? "circle-alert" : "circle-check")" /></span>
                    </span>
                    <span class="lt-kpi-value">@counter.Open.ToString("N0", CultureInfo.CurrentCulture)</span>
                    <span class="lt-kpi-note">
                        @string.Format(CultureInfo.CurrentCulture, L["Alerts.Counters.Open"], counter.Open)
                        @if (counter.OldestUnacknowledgedSince is DateTimeOffset since)
                        {
                            <span> · @string.Format(CultureInfo.CurrentCulture, L["Alerts.Counters.OldestUnacknowledged"], When(since))</span>
                        }
                    </span>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="list-title" class="lt-panel">
        <div class="lt-panel-head">
            <h2 id="list-title">@L["Alerts.List.Title"]</h2>
        </div>
        @if (_centre.Alerts.Count == 0)
        {
            <EmptyState Id="alerts-empty" IconName="circle-check" Title="@L["Alerts.List.Empty"]" Text="@L["Alerts.List.EmptyText"]" />
        }
        else
        {
            <ListFilterBar Id="alerts-filters" ActiveCount="ActiveFilters" OnReset="ResetFilters">
                <ChildContent>
                    <div class="lt-filter">
                        <label for="alerts-search">@L["Lists.Search"]</label>
                        <input id="alerts-search" type="search" @bind="_search" @bind:event="oninput" autocomplete="off" />
                    </div>
                </ChildContent>
                <More>
                    <div class="lt-filter">
                        <label for="alerts-severity">@L["Alerts.Field.Severity"]</label>
                        <select id="alerts-severity" @bind="_severityFilter">
                            <option value="">@L["Lists.AllSeverities"]</option>
                            @foreach (AlertSeverity severity in Enum.GetValues<AlertSeverity>())
                            {
                                <option value="@severity">@severity</option>
                            }
                        </select>
                    </div>
                    <div class="lt-filter">
                        <label for="alerts-state">@L["Alerts.Field.State"]</label>
                        <select id="alerts-state" @bind="_stateFilter">
                            <option value="">@L["Lists.AllStates"]</option>
                            @foreach (AlertState state in Enum.GetValues<AlertState>())
                            {
                                <option value="@state">@L["Alerts.State." + state]</option>
                            }
                        </select>
                    </div>
                    <SortSelect Id="alerts-sort" Options="SortOptions" State="_sort" OnSort="StateHasChanged" DefaultLabel="@L["Lists.Sort.Default"]" />
                </More>
            </ListFilterBar>
            @if (VisibleAlerts.Count == 0)
            {
                <EmptyState Id="alerts-filtered-empty" IconName="search" Title="@L["Lists.Empty.FilteredTitle"]" Text="@L["Lists.Empty.Filtered"]">
                    <button type="button" class="lettra-button is-secondary" id="alerts-empty-reset" @onclick="ResetFilters">@L["Lists.Filters.Reset"]</button>
                </EmptyState>
            }
            else
            {
                <div class="lt-list-scroll">
                    <table class="lettra-table lt-cards">
                        <thead>
                            <tr>
                                <SortHeader Option="Column(AlertColumn.Title)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-title" />
                                <SortHeader Option="Column(AlertColumn.Severity)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-severity" />
                                <SortHeader Option="Column(AlertColumn.Scope)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-scope" />
                                <SortHeader Option="Column(AlertColumn.State)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-state" />
                                <SortHeader Option="Column(AlertColumn.LastSeen)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-last" />
                                <SortHeader Option="Column(AlertColumn.Occurrences)" State="_sort" OnSort="StateHasChanged" Id="alerts-sort-count" Class="lg-num" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (AlertSummary alert in VisibleAlerts)
                            {
                                <tr aria-current="@(alert.Id == Id ? "true" : null)">
                                    <td><a href="alerts/@alert.Id">@RuleTitle(alert)</a></td>
                                    <td data-label="@L["Alerts.Field.Severity"]"><span class="lt-severity-badge" data-severity="@alert.Severity">@alert.Severity</span></td>
                                    <td data-label="@L["Alerts.Field.Scope"]">@L["Alerts.Scope." + alert.ScopeLevel]</td>
                                    <td data-label="@L["Alerts.Field.State"]"><span class="lt-state" data-state="@alert.State">@L["Alerts.State." + alert.State]</span></td>
                                    <td data-label="@L["Alerts.Field.LastSeen"]">@When(alert.LastSeen)</td>
                                    <td class="lg-num" data-label="@L["Alerts.Field.Occurrences"]">@alert.Occurrences</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
}

@if (_detail is not null)
{
    AlertSummary alert = _detail.Alert;
    <section aria-labelledby="detail-title" class="lt-panel lettra-alert-detail">
        <div class="lt-panel-head">
            <h2 id="detail-title"><span class="lettra-visually-hidden">@alert.Severity · </span>@RuleTitle(alert)</h2>
            <span class="lt-severity-badge" data-severity="@alert.Severity" aria-hidden="true">@alert.Severity</span>
        </div>
        <dl class="lt-facts">
            <dt>@L["Alerts.Field.State"]</dt>
            <dd>@L["Alerts.State." + alert.State]</dd>
            <dt>@L["Alerts.Field.Scope"]</dt>
            <dd>@L["Alerts.Scope." + alert.ScopeLevel]</dd>
            <dt>@L["Alerts.Field.OpenedAt"]</dt>
            <dd>@When(alert.OpenedAt)</dd>
            @if (alert.TakeoverDue is DateTimeOffset due && alert.State == AlertState.New)
            {
                <dt>@L["Alerts.Field.TakeoverDue"]</dt>
                <dd>@When(due)</dd>
            }
            @if (alert.AcknowledgedBy is not null)
            {
                <dt>@L["Alerts.Field.AcknowledgedBy"]</dt>
                <dd>@alert.AcknowledgedBy</dd>
            }
        </dl>

        @if (alert.State is AlertState.New or AlertState.Acknowledged)
        {
            <div class="lt-page-actions">
                @if (alert.State == AlertState.New)
                {
                    <button type="button" id="alert-acknowledge" class="lettra-button" disabled="@_busy" @onclick="AcknowledgeAsync">@L["Alerts.Acknowledge"]</button>
                }
                <button type="button" id="alert-resolve" class="lettra-button is-secondary" disabled="@_busy" @onclick="ResolveAsync">@L["Alerts.Resolve"]</button>
            </div>

            <EditForm Model="_severity" OnValidSubmit="ChangeSeverityAsync" FormName="alert-severity" class="lt-severity-form">
                <DataAnnotationsValidator />
                <label for="alert-severity">@L["Alerts.Severity.New"]</label>
                <InputSelect id="alert-severity" @bind-Value="_severity.Severity">
                    @foreach (AlertSeverity severity in Enum.GetValues<AlertSeverity>())
                    {
                        <option value="@severity">@severity</option>
                    }
                </InputSelect>
                <label for="alert-reason">@L["Alerts.Severity.Reason"]</label>
                <InputText id="alert-reason" @bind-Value="_severity.Reason" maxlength="@ChangeAlertSeverityRequest.MaxReasonLength" />
                <FieldErrors Field="@nameof(ChangeAlertSeverityRequest.Reason)" ServerErrors="_errors" />
                <button type="submit" class="lettra-button is-secondary" disabled="@_busy">@L["Alerts.Severity.Submit"]</button>
            </EditForm>
        }

        <h3>@L["Alerts.Timeline.Title"]</h3>
        <ol class="lettra-timeline">
            @foreach (AlertTimelineItem item in _detail.Timeline)
            {
                <li data-kind="@item.Kind">
                    <time>@When(item.At)</time> · @Event(item.Kind) · @L["Alerts.Actor." + item.ActorKind]
                    @if (!string.IsNullOrEmpty(item.Reason))
                    {
                        <span> · @item.Reason</span>
                    }
                </li>
            }
        </ol>
    </section>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private AlertCentreResponse? _centre;
    private AlertDetailResponse? _detail;
    private ChangeAlertSeverityRequest _severity = new();
    private IReadOnlyList<ErrorDetail> _errors = [];
    private bool _cabinetWide;
    private bool _includeClosed;
    private bool _busy;
    private string? _search;
    private AlertSeverity? _severityFilter;
    private AlertState? _stateFilter;

    // Ordre du serveur (gravité puis récence) tant que l'utilisateur n'a pas choisi de colonne : Default n'a pas de clé.
    private readonly SortState<AlertColumn> _sort = new(AlertColumn.Default);

    private enum AlertColumn
    {
        Default,
        Title,
        Severity,
        Scope,
        State,
        LastSeen,
        Occurrences,
    }

    private IReadOnlyList<SortOption<AlertColumn>> SortOptions =>
    [
        new(AlertColumn.Title, L["Alerts.Field.Title"]),
        new(AlertColumn.Severity, L["Alerts.Field.Severity"]),
        new(AlertColumn.Scope, L["Alerts.Field.Scope"]),
        new(AlertColumn.State, L["Alerts.Field.State"]),
        new(AlertColumn.LastSeen, L["Alerts.Field.LastSeen"], SortDirectionDto.Descending),
        new(AlertColumn.Occurrences, L["Alerts.Field.Occurrences"], SortDirectionDto.Descending),
    ];

    private SortOption<AlertColumn> Column(AlertColumn column) => SortOptions.First(o => o.Column == column);

    private int ActiveFilters => new object?[] { string.IsNullOrWhiteSpace(_search) ? null : _search, _severityFilter, _stateFilter }.Count(f => f is not null);

    private void ResetFilters() => (_search, _severityFilter, _stateFilter) = (null, null, null);

    /// <summary>Le centre charge toutes les alertes ouvertes (quelques dizaines) : filtres et tri se font à l'écran.</summary>
    private IReadOnlyList<AlertSummary> VisibleAlerts
    {
        get
        {
            IEnumerable<AlertSummary> alerts = _centre?.Alerts ?? [];
            if (!string.IsNullOrWhiteSpace(_search))
            {
                alerts = alerts.Where(a => ListSorting.Matches(RuleTitle(a), _search));
            }

            alerts = alerts.Where(a => (_severityFilter is null || a.Severity == _severityFilter) && (_stateFilter is null || a.State == _stateFilter));
            return ListSorting.Sort(alerts, _sort, new Dictionary<AlertColumn, Func<AlertSummary, object?>>
            {
                [AlertColumn.Title] = RuleTitle,
                [AlertColumn.Severity] = a => a.Severity,
                [AlertColumn.Scope] = a => L["Alerts.Scope." + a.ScopeLevel].Value,
                [AlertColumn.State] = a => a.State,
                [AlertColumn.LastSeen] = a => a.LastSeen,
                [AlertColumn.Occurrences] = a => a.Occurrences,
            });
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        await LoadDetailAsync();
    }

    private async Task ToggleCabinetAsync(ChangeEventArgs e)
    {
        _cabinetWide = e.Value is true;
        await LoadAsync();
    }

    private async Task ToggleClosedAsync(ChangeEventArgs e)
    {
        _includeClosed = e.Value is true;
        await LoadAsync();
    }

    private Task AcknowledgeAsync() => ActAsync(id => Gateway.AcknowledgeAsync(id, CancellationToken.None), "Alerts.Toast.Acknowledged");

    private Task ResolveAsync() => ActAsync(id => Gateway.ResolveAsync(id, CancellationToken.None), "Alerts.Toast.Resolved");

    private Task ChangeSeverityAsync() => ActAsync(id => Gateway.ChangeSeverityAsync(id, _severity, CancellationToken.None), "Alerts.Toast.SeverityChanged");

    private async Task ActAsync(Func<Guid, Task<OperationResult<AlertDetailResponse>>> action, string successKey)
    {
        if (_detail is null)
        {
            return;
        }

        _busy = true;
        try
        {
            OperationResult<AlertDetailResponse> result = await action(_detail.Alert.Id);
            if (result.IsSuccess)
            {
                _detail = result.Value;
                _severity = new ChangeAlertSeverityRequest { Severity = result.Value!.Alert.Severity };
                _errors = [];
                Toasts.Show(ToastKind.Success, L[successKey].Value);
                await LoadAsync();
            }
            else
            {
                _errors = result.Errors;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        OperationResult<AlertCentreResponse> result = await Gateway.ListAsync(_cabinetWide, _includeClosed, CancellationToken.None);
        if (result.IsSuccess)
        {
            _centre = result.Value;
        }
        else
        {
            _errors = result.Errors;
            _centre = new AlertCentreResponse([], []);
        }
    }

    private async Task LoadDetailAsync()
    {
        _detail = null;
        if (Id is not Guid id)
        {
            return;
        }

        OperationResult<AlertDetailResponse> result = await Gateway.GetAsync(id, _cabinetWide, CancellationToken.None);
        if (result.IsSuccess)
        {
            _detail = result.Value;
            _severity = new ChangeAlertSeverityRequest { Severity = result.Value!.Alert.Severity };
        }
        else
        {
            _errors = result.Errors;
        }
    }

    /// <summary>Titre traduit de la règle quand elle est connue, sinon celui de la règle (technique, sans donnée de dossier).</summary>
    private string RuleTitle(AlertSummary alert)
    {
        LocalizedString text = L["Alerts.Rule." + alert.RuleId];
        return text.ResourceNotFound ? alert.Title : text.Value;
    }

    /// <summary>« SeverityChanged:S2 » devient « Gravité changée : S2 ».</summary>
    private string Event(string kind)
    {
        string[] parts = kind.Split(':', 2);
        LocalizedString text = L["Alerts.Event." + parts[0]];
        string label = text.ResourceNotFound ? parts[0] : text.Value;
        return parts.Length == 2 ? string.Format(CultureInfo.CurrentCulture, L["Alerts.Event.WithValue"], label, parts[1]) : label;
    }

    private static string When(DateTimeOffset at) => at.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);
}
