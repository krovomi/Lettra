@* Qui est connecté, et verrouiller / se déconnecter. Sans session, renvoie vers l'écran de session. *@
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject ISessionGateway Sessions
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject DeviceLock DeviceLock

@if (DeviceLock.HasPin)
{
    <button type="button" id="device-lock-now" class="lettra-link" @onclick="DeviceLock.Lock" title="@L["Pin.LockNow"]">@L["Pin.LockNow"]</button>
}
@if (_session is { IsAuthenticated: true })
{
    <span class="lettra-user">@_session.DisplayName</span>
    @if (_session.SignOutUrl is string signOut)
    {
        <a href="@signOut" data-sign-out @onclick="() => SignOutAsync(signOut)" @onclick:preventDefault>@L["Session.SignOut"]</a>
    }
    else if (_session.Mode == SessionModeDto.Local)
    {
        <button type="button" class="lettra-link" @onclick="LockAsync">@L["Session.Lock"]</button>
    }
}

@code {
    private SessionResponse? _session;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        OperationResult<SessionResponse> result = await Sessions.GetAsync(CancellationToken.None);
        _session = result.Value;
        if (result.IsSuccess && _session is { IsAuthenticated: false } && !OnPageWithoutSession())
        {
            Navigation.NavigateTo("session");
        }
    }

    /// <summary>
    /// Déconnexion du navigateur : les brouillons hors ligne partent d'abord (la déconnexion demande le réseau), puis
    /// ceux de l'utilisateur et du dossier sont effacés de l'appareil, avec le cache, pour la personne suivante sur le
    /// poste. S'il en reste qui n'ont pas pu partir, l'utilisateur confirme avant de les perdre.
    /// </summary>
    private async Task SignOutAsync(string signOut)
    {
        if (Services.GetService<OfflineDrafts>() is { } drafts)
        {
            await drafts.SyncAsync(CancellationToken.None);
            int left = (await drafts.ListAsync(CancellationToken.None)).Count;
            if (left > 0 && !await JS.InvokeAsync<bool>("confirm", string.Format(CultureInfo.CurrentCulture, L["Drafts.SignOutPending"], left)))
            {
                return;
            }

            await drafts.ClearAsync(CancellationToken.None);
        }

        Navigation.NavigateTo(signOut, forceLoad: true);
    }

    private async Task LockAsync()
    {
        await Sessions.LockAsync(CancellationToken.None);
        _session = null;
        Navigation.NavigateTo("session");
    }

    // L'écran de session lui-même, et la mesure de la grille, qui ne lit aucun dossier : la version de mesure
    // s'ouvre dessus au premier lancement, avant tout compte local.
    private bool OnPageWithoutSession()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return path.StartsWith("session", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("mesure-grille", StringComparison.OrdinalIgnoreCase);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Composant retiré pendant la navigation : rien à rafraîchir.
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
