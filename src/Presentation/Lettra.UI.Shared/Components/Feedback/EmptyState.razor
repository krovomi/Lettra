@* État vide illustré (vague 5, lane E) : une icône, ce qui manque et l'action principale pour commencer. *@

<div class="lt-empty" id="@Id">
    <span class="lt-empty-icon" aria-hidden="true"><Icon Name="@IconName" Size="28" /></span>
    <h3>@Title</h3>
    @if (!string.IsNullOrEmpty(Text))
    {
        <p>@Text</p>
    }
    @if (ChildContent is not null)
    {
        <div class="lt-page-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    [Parameter, EditorRequired] public string IconName { get; set; } = "inbox";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Text { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
