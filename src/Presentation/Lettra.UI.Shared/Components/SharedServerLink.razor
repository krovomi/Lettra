@* Sur l'écran de session de l'application installée : où sont les données (cet appareil ou le serveur du cabinet) et le
   lien pour changer. Rien dans le navigateur, qui travaille toujours sur son serveur. *@
@using Microsoft.Extensions.DependencyInjection
@inject Optional<IServerConnection> OptionalConnection
@inject IStringLocalizer<SharedResource> L

@if (OptionalConnection.Value is { } connection)
{
    <section class="lettra-card" aria-labelledby="shared-server-link-title">
        <h2 id="shared-server-link-title">@L["SharedServer.Title"]</h2>
        <p>
            @if (connection.CurrentServer is Uri server)
            {
                @string.Format(CultureInfo.CurrentCulture, L["SharedServer.Now.Server"], server.GetLeftPart(UriPartial.Authority))
            }
            else
            {
                @L["SharedServer.Now.Device"]
            }
        </p>
        <a id="shared-server-link" href="session/serveur">@L[connection.CurrentServer is null ? "SharedServer.Link.Use" : "SharedServer.Link.Change"]</a>
    </section>
}
