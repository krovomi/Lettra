@* Calendrier d'un champ de date, dans la langue de l'écran : nom des mois, jours de la semaine et premier jour (lundi en
   français, dimanche en anglais). Flèches : jour ou semaine ; Pg préc./Pg suiv. : mois ; Début/Fin : semaine ; Échap : fermer. *@
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="lt-date-backdrop" @onclick="CloseAsync"></div>
<div class="lt-date-calendar" id="@Id" @ref="_calendar" role="dialog" aria-modal="false" aria-label="@Label" @onkeydown="KeyAsync">
    <div class="lt-date-calendar-head">
        <button type="button" class="lt-icon-button" id="@($"{Id}-previous")" aria-label="@L["Dates.Calendar.Previous"]" @onclick="() => Move(_focused.AddMonths(-1))">
            <Icon Name="chevron-left" Size="18" />
        </button>
        <strong id="@($"{Id}-month")" aria-live="polite">@MonthTitle</strong>
        <button type="button" class="lt-icon-button" id="@($"{Id}-next")" aria-label="@L["Dates.Calendar.Next"]" @onclick="() => Move(_focused.AddMonths(1))">
            <Icon Name="chevron-right" Size="18" />
        </button>
    </div>
    <table class="lt-date-grid" role="grid" aria-labelledby="@($"{Id}-month")">
        <thead>
            <tr>
                @foreach (DayOfWeek day in WeekDays)
                {
                    <th scope="col" abbr="@Culture.DateTimeFormat.GetDayName(day)">@Culture.DateTimeFormat.GetAbbreviatedDayName(day)</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int week = 0; week < 6; week++)
            {
                <tr>
                    @for (int column = 0; column < 7; column++)
                    {
                        DateOnly day = FirstCell.AddDays((week * 7) + column);
                        bool focused = day == _focused;
                        <td>
                            @if (focused)
                            {
                                <button type="button" @ref="_focusedButton" @attributes="DayAttributes(day)" @onclick="() => PickAsync(day)">@day.Day</button>
                            }
                            else
                            {
                                <button type="button" @attributes="DayAttributes(day)" @onclick="() => PickAsync(day)">@day.Day</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <div class="lt-date-calendar-foot">
        <button type="button" class="lettra-link" id="@($"{Id}-today")" disabled="@(!Allowed(Today))" @onclick="() => PickAsync(Today)">@L["Dates.Calendar.Today"]</button>
        <button type="button" class="lettra-link" id="@($"{Id}-close")" @onclick="CloseAsync">@L["Dates.Calendar.Close"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter] public string? Label { get; set; }

    [Parameter] public DateOnly? Value { get; set; }

    [Parameter] public DateOnly? Min { get; set; }

    [Parameter] public DateOnly? Max { get; set; }

    [Parameter, EditorRequired] public DateOnly Today { get; set; }

    [Parameter] public EventCallback<DateOnly> OnPick { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private DateOnly _focused;
    private ElementReference _focusedButton;
    private bool _focusPending = true;
    private ElementReference _calendar;
    private IJSObjectReference? _module;

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private IEnumerable<DayOfWeek> WeekDays =>
        Enumerable.Range(0, 7).Select(i => (DayOfWeek)(((int)Culture.DateTimeFormat.FirstDayOfWeek + i) % 7));

    private DateOnly FirstCell
    {
        get
        {
            DateOnly first = new(_focused.Year, _focused.Month, 1);
            int offset = ((int)first.DayOfWeek - (int)Culture.DateTimeFormat.FirstDayOfWeek + 7) % 7;
            return first.AddDays(-offset);
        }
    }

    private string MonthTitle
    {
        get
        {
            string title = new DateOnly(_focused.Year, _focused.Month, 1).ToString("MMMM yyyy", Culture);
            return title.Length == 0 ? title : char.ToUpper(title[0], Culture) + title[1..];
        }
    }

    protected override void OnInitialized() => _focused = Clamp(Value ?? Today);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await PlaceAsync();
        }

        if (_focusPending)
        {
            _focusPending = false;
            try
            {
                await _focusedButton.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Rendu sans navigateur (tests) : rien à focaliser.
            }
        }
    }

    /// <summary>Aligne le calendrier à droite du champ s'il sortirait de la fenêtre (lettra-dates.js).</summary>
    private async Task PlaceAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference?>("import", DateModule.Path);
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("placeCalendar", _calendar);
            }
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Hôte fermé.
            }
        }
    }

    private Dictionary<string, object> DayAttributes(DateOnly day)
    {
        bool selected = day == Value;
        Dictionary<string, object> attributes = new(StringComparer.Ordinal)
        {
            ["class"] = string.Join(' ', new[]
            {
                "lt-date-day lettra-link",
                day.Month != _focused.Month ? "is-outside" : null,
                day == Today ? "is-today" : null,
                selected ? "is-selected" : null,
            }.Where(c => c is not null)),
            ["data-date"] = day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["tabindex"] = day == _focused ? "0" : "-1",
            ["aria-label"] = day.ToString("D", Culture),
            ["aria-pressed"] = selected ? "true" : "false",
        };
        if (day == Today)
        {
            attributes["aria-current"] = "date";
        }

        if (!Allowed(day))
        {
            attributes["disabled"] = true;
        }

        return attributes;
    }

    private bool Allowed(DateOnly day) => (Min is not { } min || day >= min) && (Max is not { } max || day <= max);

    private DateOnly Clamp(DateOnly day) =>
        Min is { } min && day < min ? min : Max is { } max && day > max ? max : day;

    private void Move(DateOnly day)
    {
        _focused = Clamp(day);
        _focusPending = true;
    }

    private async Task PickAsync(DateOnly day)
    {
        if (Allowed(day))
        {
            await OnPick.InvokeAsync(day);
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        int column = ((int)_focused.DayOfWeek - (int)Culture.DateTimeFormat.FirstDayOfWeek + 7) % 7;
        switch (e.Key)
        {
            case "ArrowLeft":
                Move(_focused.AddDays(-1));
                break;
            case "ArrowRight":
                Move(_focused.AddDays(1));
                break;
            case "ArrowUp":
                Move(_focused.AddDays(-7));
                break;
            case "ArrowDown":
                Move(_focused.AddDays(7));
                break;
            case "PageUp":
                Move(_focused.AddMonths(e.ShiftKey ? -12 : -1));
                break;
            case "PageDown":
                Move(_focused.AddMonths(e.ShiftKey ? 12 : 1));
                break;
            case "Home":
                Move(_focused.AddDays(-column));
                break;
            case "End":
                Move(_focused.AddDays(6 - column));
                break;
            case "Escape":
                await CloseAsync();
                break;
        }
    }
}
