@* Brouillons gardés sur l'appareil faute de réseau (étape 4.5) : combien, lesquels, et l'envoi au retour du réseau.
   Rien sans brouillons hors ligne (MAUI, poste isolé) ou quand aucun n'attend. *@
@implements IAsyncDisposable
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@if (_drafts is not null && _pending.Count > 0)
{
    <div id="offline-drafts" class="lettra-banner is-info" role="status">
        <span>@string.Format(CultureInfo.CurrentCulture, L["Drafts.Banner"], _pending.Count)</span>
        <ul>
            @foreach (OfflineDraft draft in _pending)
            {
                <li>
                    <a href="@LinkOf(draft)">@L[$"Drafts.Kind.{draft.Kind}"] · @(draft.Title ?? L["Drafts.NoCustomer"])</a>
                    @if (draft.LastError is { } code)
                    {
                        <span class="validation-message"> @L[$"Drafts.Error.{(KnownError(code) ? code.Replace('.', '_') : "Other")}"]</span>
                    }
                </li>
            }
        </ul>
        <button type="button" id="offline-drafts-send" class="lettra-button is-secondary" disabled="@_busy" @onclick="SendAsync">@L["Drafts.SendNow"]</button>
        @if (_offline)
        {
            <span id="offline-drafts-offline">@L["Drafts.StillOffline"]</span>
        }
    </div>
}

@code {
    private OfflineDrafts? _drafts;
    private IReadOnlyList<OfflineDraft> _pending = [];
    private DotNetObjectReference<OfflineDraftsBanner>? _self;
    private IJSObjectReference? _module;
    private bool _busy;
    private bool _offline;

    protected override async Task OnInitializedAsync()
    {
        _drafts = Services.GetService<OfflineDrafts>();
        if (_drafts is null)
        {
            return;
        }

        _drafts.Changed += OnChanged;
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _drafts is null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference?>("import", IndexedDbDraftStore.ModulePath);
            if (_module is not null)
            {
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("watchOnline", _self);
            }
        }
        catch (JSException)
        {
            // Pas de module (tests) : l'envoi reste au bouton.
        }

        // À l'ouverture de l'application : ce qui attend part si le réseau est là.
        if (_pending.Count > 0)
        {
            await SendAsync();
        }
    }

    [JSInvokable]
    public Task OnOnline() => InvokeAsync(SendAsync);

    private async Task SendAsync()
    {
        if (_drafts is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();
        try
        {
            OfflineDraftSyncReport report = await _drafts.SyncAsync(CancellationToken.None);
            _offline = report.Offline;
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync() =>
        _pending = [.. (await _drafts!.ListAsync(CancellationToken.None)).OrderBy(d => d.SavedAt)];

    private static string LinkOf(OfflineDraft draft) => (draft.Kind, draft.ServerId) switch
    {
        (OfflineDraftKind.Quote, Guid id) => $"quotes/{id}",
        (OfflineDraftKind.Quote, null) => $"quotes/draft/{draft.LocalId}",
        (_, Guid id) => $"invoices/{id}",
        _ => $"invoices/draft/{draft.LocalId}",
    };

    private static bool KnownError(string code) =>
        code is OfflineDrafts.CorruptedCode or ErrorCodes.Concurrency.VersionMismatch;

    private void OnChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_drafts is not null)
        {
            _drafts.Changed -= OnChanged;
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatchOnline");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page fermée.
            }
        }

        _self?.Dispose();
    }
}
