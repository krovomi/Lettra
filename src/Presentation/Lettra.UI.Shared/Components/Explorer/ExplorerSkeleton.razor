@* Chargement d'une liste ou d'une fiche : des lignes grises plutôt qu'un texte, pour que l'écran ne saute pas. *@
@inject IStringLocalizer<SharedResource> L

<div class="lt-explorer-skeleton" aria-busy="true" aria-label="@L["Loading"]">
    @for (int i = 0; i < Rows; i++)
    {
        <span class="lt-skeleton" style="width: @(90 - (i % 3 * 15))%"></span>
    }
</div>

@code {
    [Parameter] public int Rows { get; set; } = 5;
}
