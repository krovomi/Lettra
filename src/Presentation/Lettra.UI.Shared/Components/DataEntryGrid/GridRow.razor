@typeparam TItem where TItem : class
@implements IDisposable
@* Une ligne de grille. Ne se re-rend que si son élément immuable, son index ou son état change ;
   après une saisie, la grille la met à jour seule (Update) sans re-rendre les autres lignes. *@
<div class="lg-row @CssClass" role="row" aria-rowindex="@(Index + 2)" data-r="@Index">
    @for (int c = 0; c < Columns.Count; c++)
    {
        GridColumn<TItem> column = Columns[c];
        <div class="lg-cell @(column.Numeric ? "lg-num" : null) @(column.Wide ? "lg-wide" : null)" role="gridcell" data-label="@column.Label">
            @if (column.IsEditable)
            {
                <input class="lg-input" data-r="@Index" data-c="@c" value="@column.Display(_item)"
                       readonly="@ReadOnly" aria-label="@string.Format(CultureInfo.CurrentCulture, CellLabelFormat, column.Label, Index + 1)"
                       autocomplete="off" spellcheck="false" inputmode="@(column.Numeric ? "decimal" : "text")" />
            }
            else
            {
                <span class="lg-calc">@column.Display(_item)</span>
            }
        </div>
    }
    @if (DeleteLabelFormat is not null)
    {
        <div class="lg-cell lg-row-action" role="gridcell">
            @if (!ReadOnly)
            {
                <RowDelete Label="@string.Format(CultureInfo.CurrentCulture, DeleteLabelFormat, Index + 1)" Confirm="false" TabIndex="-1"
                           OnDelete="() => OnDelete.InvokeAsync(Index)" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TItem Item { get; set; } = default!;

    [Parameter, EditorRequired] public int Index { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<GridColumn<TItem>> Columns { get; set; } = default!;

    [Parameter, EditorRequired] public object RowKey { get; set; } = default!;

    /// <summary>Libellé accessible d'une cellule : {0} = colonne, {1} = numéro de ligne (traduit par la grille).</summary>
    [Parameter, EditorRequired] public string CellLabelFormat { get; set; } = "{0} {1}";

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public string? CssClass { get; set; }

    /// <summary>Libellé de la corbeille ({0} = numéro de ligne) ; <c>null</c> : pas de corbeille.</summary>
    [Parameter] public string? DeleteLabelFormat { get; set; }

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    [CascadingParameter] public IGridRowRegistry<TItem>? Registry { get; set; }

    private TItem _item = default!;
    private TItem? _renderedItem;
    private int _renderedIndex = -1;
    private bool _renderedReadOnly;
    private string? _renderedCss;
    private IReadOnlyList<GridColumn<TItem>>? _renderedColumns;
    private string? _renderedLabelFormat;
    private string? _renderedDeleteFormat;

    protected override void OnInitialized() => Registry?.Attach(RowKey, this);

    protected override void OnParametersSet() => _item = Item;

    /// <summary>Remplace l'élément affiché et ne re-rend que cette ligne.</summary>
    public void Update(TItem item)
    {
        _item = item;
        StateHasChanged();
    }

    protected override bool ShouldRender() =>
        !ReferenceEquals(_renderedItem, _item) || _renderedIndex != Index || _renderedReadOnly != ReadOnly
        || _renderedCss != CssClass || !ReferenceEquals(_renderedColumns, Columns) || _renderedLabelFormat != CellLabelFormat
        || _renderedDeleteFormat != DeleteLabelFormat;

    protected override void OnAfterRender(bool firstRender)
    {
        _renderedItem = _item;
        _renderedIndex = Index;
        _renderedReadOnly = ReadOnly;
        _renderedCss = CssClass;
        _renderedColumns = Columns;
        _renderedLabelFormat = CellLabelFormat;
        _renderedDeleteFormat = DeleteLabelFormat;
    }

    public void Dispose() => Registry?.Detach(RowKey, this);
}
