@typeparam TColumn where TColumn : notnull
@inject IStringLocalizer<SharedResource> L
@* Tri en liste déroulante, pour le téléphone où les en-têtes de colonnes sont masqués (listes en cartes). Chaque
   colonne apparaît deux fois : croissant puis décroissant. *@

<div class="lt-filter lt-sort-select @(PhoneOnly ? "is-phone-only" : null)">
    <label for="@Id">@L["Lists.Sort.Label"]</label>
    <select id="@Id" value="@(IsDefault ? DefaultValue : Value(State.Column, State.Direction))" @onchange="ChangeAsync">
        @if (DefaultLabel is not null)
        {
            <option value="@DefaultValue">@DefaultLabel</option>
        }
        @foreach (SortOption<TColumn> option in Options)
        {
            foreach (SortDirectionDto direction in Directions(option))
            {
                <option value="@Value(option.Column, direction)">@string.Format(CultureInfo.CurrentCulture, L[$"Lists.Sort.{direction}"], option.Label)</option>
            }
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SortOption<TColumn>> Options { get; set; } = [];

    [Parameter, EditorRequired] public SortState<TColumn> State { get; set; } = default!;

    [Parameter] public EventCallback OnSort { get; set; }

    [Parameter] public string Id { get; set; } = "list-sort";

    /// <summary>Masquée à partir de la tablette, où les en-têtes de colonnes trient (par défaut).</summary>
    [Parameter] public bool PhoneOnly { get; set; } = true;

    /// <summary>
    /// Libellé de l'ordre d'ouverture de l'écran quand il ne correspond à aucune colonne (urgence, ordre du serveur) :
    /// proposé en tête de liste, il remet le tri d'origine.
    /// </summary>
    [Parameter] public string? DefaultLabel { get; set; }

    private const string DefaultValue = "";

    private bool IsDefault => DefaultLabel is not null && !State.IsChanged;

    private static IEnumerable<SortDirectionDto> Directions(SortOption<TColumn> option) => option.FirstDirection == SortDirectionDto.Descending
        ? [SortDirectionDto.Descending, SortDirectionDto.Ascending]
        : [SortDirectionDto.Ascending, SortDirectionDto.Descending];

    private static string Value(TColumn column, SortDirectionDto direction) => $"{column}:{direction}";

    private Task ChangeAsync(ChangeEventArgs args)
    {
        string value = args.Value?.ToString() ?? string.Empty;
        if (DefaultLabel is not null && value.Length == 0)
        {
            State.Reset();
            return OnSort.InvokeAsync();
        }

        int separator = value.LastIndexOf(':');
        SortOption<TColumn>? option = separator < 0 ? null : Options.FirstOrDefault(o => string.Equals(o.Column.ToString(), value[..separator], StringComparison.Ordinal));
        if (option is null || !Enum.TryParse(value[(separator + 1)..], out SortDirectionDto direction) || !Enum.IsDefined(direction))
        {
            return Task.CompletedTask;
        }

        State.Set(option.Column, direction);
        return OnSort.InvokeAsync();
    }
}
