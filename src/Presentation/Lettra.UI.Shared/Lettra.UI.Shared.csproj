<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Razor Class Library : TOUTE l'UI, partagée par le WASM et le MAUI.
       Ne voit que les contrats, les ports UI et les calculs purs : jamais le domaine ni EF. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lettra.UI.Abstractions\Lettra.UI.Abstractions.csproj" />
    <!-- Fonctions pures partagées (ADR-0005) : le prix TTC affiché par le catalogue est celui que retiendra le serveur. -->
    <ProjectReference Include="..\..\Core\Lettra.Calculations\Lettra.Calculations.csproj" />
    <!-- Rendu PDF des documents, local : fonctionne hors ligne en MAUI comme dans le navigateur. -->
    <ProjectReference Include="..\Lettra.Printing\Lettra.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

</Project>
