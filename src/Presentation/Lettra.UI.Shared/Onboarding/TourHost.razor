@* Lance le parcours de l'écran à la première visite (une fois, par utilisateur et par version du parcours), et celui de
   l'assistant à sa première ouverture. Posé une fois dans la coque (MainLayout). Jamais avant l'ouverture de la
   session : le voile du parcours couvrirait l'écran de connexion et intercepterait le bouton « Se connecter ». *@
@implements IAsyncDisposable
@inject GuidedTours Tours
@inject NavigationManager Navigation
@inject AssistantPanelState Assistant
@inject SessionState Session
@inject IJSRuntime JS

<GuidedTour />

@code {
    private IJSObjectReference? _module;
    private bool? _canAutoStart;
    private bool _assistantWasOpen;
    private bool _starting;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Assistant.Changed += OnAssistantChanged;
        Session.Changed += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AutoStartAsync(TourCatalog.ForPath(Navigation.ToBaseRelativePath(Navigation.Uri)));
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => AutoStartAsync(TourCatalog.ForPath(Navigation.ToBaseRelativePath(e.Location))));

    // La session s'ouvre (connexion, déverrouillage) : le parcours de l'écran affiché peut alors commencer.
    private void OnSessionChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() => AutoStartAsync(TourCatalog.ForPath(Navigation.ToBaseRelativePath(Navigation.Uri))));

    private void OnAssistantChanged(object? sender, EventArgs e)
    {
        bool opened = Assistant.IsOpen && !_assistantWasOpen;
        _assistantWasOpen = Assistant.IsOpen;
        if (opened && TourCatalog.Find(TourCatalog.AssistantTourId) is { } tour)
        {
            _ = InvokeAsync(() => AutoStartAsync(tour));
        }
    }

    private async Task AutoStartAsync(TourDefinition? tour)
    {
        if (tour is null || _starting || Tours.Active is not null || !Session.IsAuthenticated || OnSessionScreen()
            || !await CanAutoStartAsync())
        {
            return;
        }

        _starting = true;   // navigation et lecture de session arrivent ensemble : un seul démarrage
        try
        {
            await Tours.StartIfNewAsync(tour);
        }
        finally
        {
            _starting = false;
        }
    }

    private bool OnSessionScreen() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("session", StringComparison.OrdinalIgnoreCase);

    /// <summary>Jamais sans navigateur (tests bUnit, prérendu) ni sous un navigateur piloté (tests Playwright).</summary>
    private async Task<bool> CanAutoStartAsync()
    {
        if (_canAutoStart is { } known)
        {
            return known;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference?>("import", TourModule.Path);
            _canAutoStart = _module is not null && await _module.InvokeAsync<bool>("canAutoStart");
        }
        catch (JSException)
        {
            _canAutoStart = false;
        }
        catch (InvalidOperationException)
        {
            return false;   // pas encore de JS (prérendu) : on retentera
        }

        return _canAutoStart.Value;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Assistant.Changed -= OnAssistantChanged;
        Session.Changed -= OnSessionChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
