@* Bouton « ? » de la barre du haut : ouvre l'aide (questions fréquentes, tutoriel de l'écran, recherche générale). *@
@inject HelpPanelState Help
@inject IStringLocalizer<SharedResource> L

<button type="button" id="tour-help" class="lt-icon-button" data-tour="help" aria-label="@L["Tour.Help"]" title="@L["Tour.Help"]"
        aria-haspopup="dialog" aria-expanded="@(Help.IsOpen ? "true" : "false")" aria-controls="help-panel" @onclick="() => Help.Open()">
    <Icon Name="circle-help" />
</button>
